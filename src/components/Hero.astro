---
import Icon from "./Icon.astro";

const tiles = [
  { icon: "cpu", name: "Lumina-70B", tag: "Model", tint: "from-indigo-500/20 to-violet-500/10" },
  { icon: "plug", name: "Unified API", tag: "Gateway", tint: "from-cyan-500/20 to-sky-500/10" },
  { icon: "database", name: "DataLake", tag: "Dataset", tint: "from-violet-500/20 to-fuchsia-500/10" },
  { icon: "terminal", name: "PromptKit", tag: "Tool", tint: "from-emerald-500/20 to-teal-500/10" },
  { icon: "layers", name: "UI Blocks", tag: "Template", tint: "from-amber-500/20 to-orange-500/10" },
  { icon: "workflow", name: "EvalOps", tag: "Tool", tint: "from-rose-500/20 to-pink-500/10" },
];
---

<section id="top" class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <!-- Background -->
  <div class="absolute inset-0 -z-10 grid-bg"></div>
  <div class="orb -z-10" style="top:-8%;left:12%;width:420px;height:420px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
  <div class="orb -z-10 animate-pulse-glow" style="top:6%;right:8%;width:380px;height:380px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>
  <div class="orb -z-10" style="top:42%;left:42%;width:340px;height:340px;background:radial-gradient(circle,#8b5cf6,transparent 70%)"></div>

  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <a href="#featured" class="chip mx-auto mb-6 hover:border-[color:var(--primary)] transition-colors">
        <span class="grid place-items-center h-4 w-4 rounded-full text-white" style="background-image:linear-gradient(135deg,var(--primary),var(--secondary))">
          <Icon name="sparkles" size={11} strokeWidth={2.5} />
        </span>
        Curated AI tools & resources
        <Icon name="arrow-right" size={14} class="t-muted" />
      </a>

      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight">
        The AI resource hub for
        <span class="gradient-text">modern builders</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg t-soft leading-relaxed">
        Discover, compare, and ship with the best AI models, APIs, tools, and datasets — hand-picked and vetted for developers, startups, and teams.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#featured" class="btn btn-gradient w-full sm:w-auto">
          Explore resources
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#cta" class="btn btn-ghost w-full sm:w-auto">
          <Icon name="rocket" size={18} />
          Submit your tool
        </a>
      </div>

      <!-- Trust row -->
      <div class="mt-9 flex items-center justify-center gap-3 text-sm t-muted">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="shield-check" size={16} class="text-[color:var(--primary)]" />
        </span>
        <span>Independent & engineer-reviewed</span>
      </div>
    </div>

    <!-- Hero visual -->
    <div class="relative mx-auto mt-16 max-w-5xl" data-reveal>
      <!-- Floating accent cards -->
      <div class="hidden sm:flex absolute -left-6 top-10 z-20 animate-floaty">
        <div class="glass rounded-2xl border b-base p-3 shadow-xl flex items-center gap-2.5">
          <span class="icon-tile h-9 w-9"><Icon name="gauge" size={18} /></span>
          <div class="leading-tight">
            <p class="text-xs t-muted">Engineer reviewed</p>
            <p class="text-sm font-semibold t-strong">Every entry</p>
          </div>
        </div>
      </div>
      <div class="hidden sm:flex absolute -right-5 top-24 z-20 animate-floaty-slow">
        <div class="glass rounded-2xl border b-base p-3 shadow-xl flex items-center gap-2.5">
          <span class="grid place-items-center h-9 w-9 rounded-lg text-white" style="background-image:linear-gradient(135deg,var(--secondary),var(--primary))"><Icon name="trending-up" size={18} /></span>
          <div class="leading-tight">
            <p class="text-xs t-muted">New this week</p>
            <p class="text-sm font-semibold t-strong">Updated</p>
          </div>
        </div>
      </div>

      <!-- Product card -->
      <div class="relative rounded-[1.5rem] border b-strong p-2 shadow-2xl overflow-hidden"
        style="background:linear-gradient(180deg,var(--surface),var(--surface-2))">
        <div class="absolute inset-0 -z-10 opacity-60 grid-bg" style="mask-image:radial-gradient(ellipse 90% 70% at 50% 0%,#000,transparent 75%)"></div>
        <!-- Top bar -->
        <div class="flex items-center justify-between px-4 py-3">
          <div class="flex items-center gap-1.5">
            <span class="h-3 w-3 rounded-full bg-rose-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
          </div>
          <div class="chip"><Icon name="search" size={13} /> Search AI tools</div>
          <span class="chip"><Icon name="globe" size={13} /> Global</span>
        </div>

        <!-- Tile grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-3 pt-1">
          {tiles.map((t) => (
            <div class={`group rounded-2xl border b-base p-4 bg-gradient-to-br ${t.tint} hover:border-[color:var(--primary)] transition-colors`}>
              <div class="flex items-center justify-between">
                <span class="icon-tile h-10 w-10"><Icon name={t.icon} size={20} /></span>
                <Icon name="arrow-up-right" size={16} class="t-muted group-hover:t-strong transition-colors" />
              </div>
              <p class="mt-3 font-semibold t-strong">{t.name}</p>
              <p class="text-xs t-muted">{t.tag}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
