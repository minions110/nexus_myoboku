---
import Icon from "../Icon.astro";

const field = "mt-1.5 w-full rounded-lg border b-strong bg-surface px-3.5 py-2.5 text-sm t-strong placeholder:t-muted outline-none focus:border-[color:var(--primary)] transition-colors";
const label = "block";
const labelSpan = "text-sm font-medium t-soft";

const tiers = ["Starter ($19)", "Premium ($39)", "Full ($69)"];
---

<div class="card p-6 sm:p-8" data-reveal>
  <form
    id="design-request-form"
    action="mailto:myobokuai@gmail.com"
    method="post"
    enctype="text/plain"
    class="space-y-6"
  >
    <input type="hidden" name="product" value="AI Custom Bracelet Design" />

    <!-- Contact -->
    <fieldset>
      <legend class="text-sm font-semibold uppercase tracking-wide t-muted mb-3">Contact</legend>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class={label}>
          <span class={labelSpan}>Name</span>
          <input required type="text" name="name" placeholder="Your name" class={field} />
        </label>
        <label class={label}>
          <span class={labelSpan}>Email <span class="text-rose-500">*</span></span>
          <input required type="email" name="email" placeholder="you@email.com" class={field} />
        </label>
      </div>
    </fieldset>

    <!-- Bracelet Information -->
    <fieldset>
      <legend class="text-sm font-semibold uppercase tracking-wide t-muted mb-3">Bracelet Information</legend>
      <div class="grid sm:grid-cols-3 gap-4">
        <label class={label}>
          <span class={labelSpan}>Design Package</span>
          <select name="tier" class={field} id="tier-select">
            {tiers.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label class={label}>
          <span class={labelSpan}>Wrist Size</span>
          <input type="text" name="wrist_size" placeholder="e.g. 15 cm / 6 in" class={field} />
        </label>
        <label class={label}>
          <span class={labelSpan}>Budget Range</span>
          <input type="text" name="budget" placeholder="e.g. $20–$50 for materials" class={field} />
        </label>
      </div>
      <label class={`${label} mt-4`}>
        <span class={labelSpan}>Occasion</span>
        <input type="text" name="occasion" placeholder="e.g. birthday, anniversary, self-care, travel memory" class={field} />
      </label>
    </fieldset>

    <!-- Design Preferences -->
    <fieldset>
      <legend class="text-sm font-semibold uppercase tracking-wide t-muted mb-3">Design Preferences</legend>
      <div class="grid sm:grid-cols-3 gap-4">
        <label class={label}>
          <span class={labelSpan}>Style</span>
          <input type="text" name="style" placeholder="e.g. minimalist, boho, elegant" class={field} />
        </label>
        <label class={label}>
          <span class={labelSpan}>Color Preferences</span>
          <input type="text" name="colors" placeholder="e.g. soft pink, lavender, earth tones" class={field} />
        </label>
        <label class={label}>
          <span class={labelSpan}>Material Preferences</span>
          <input type="text" name="materials" placeholder="e.g. amethyst, freshwater pearl, gold accents" class={field} />
        </label>
      </div>
    </fieldset>

    <!-- Story / Emotion -->
    <fieldset>
      <legend class="text-sm font-semibold uppercase tracking-wide t-muted mb-3">Story &amp; Emotion</legend>
      <label class={label}>
        <span class={labelSpan}>Tell us the story, emotion, memory, or meaning you'd like the bracelet to express.</span>
        <textarea required rows="6" name="story" placeholder="Share as much or as little as you like — the more context you give, the more personal the design can be." class={`${field} resize-y`}></textarea>
      </label>
    </fieldset>

    <!-- Reference Images -->
    <fieldset>
      <legend class="text-sm font-semibold uppercase tracking-wide t-muted mb-3">Reference Images <span class="font-normal normal-case tracking-normal">(Optional)</span></legend>
      <label class={label}>
        <span class={labelSpan}>Upload color inspiration, bracelet references, travel photos or mood images.</span>
        <input type="file" name="reference_images" multiple accept="image/*" class={`${field} file:mr-3 file:rounded-lg file:border-0 file:bg-surface-2 file:px-3 file:py-1.5 file:text-sm file:font-medium file:t-strong cursor-pointer`} />
      </label>
    </fieldset>

    <!-- Additional Notes -->
    <fieldset>
      <legend class="text-sm font-semibold uppercase tracking-wide t-muted mb-3">Additional Notes</legend>
      <label class={label}>
        <span class={labelSpan}>Anything else you'd like us to know?</span>
        <textarea rows="3" name="additional_notes" placeholder="Any other details, concerns or questions." class={`${field} resize-y`}></textarea>
      </label>
    </fieldset>

    <!-- Privacy note -->
    <div class="rounded-lg border b-base bg-surface-2 p-4 text-xs t-muted leading-relaxed">
      <p class="flex items-start gap-2">
        <Icon name="shield-check" size={14} class="text-[color:var(--primary)] shrink-0 mt-0.5" />
        <span>
          Please only upload images and content that you have the right to share. Do not upload sensitive personal documents (ID, passport, bank cards) or payment information.
        </span>
      </p>
    </div>

    <button type="submit" class="btn btn-gradient w-full">
      <Icon name="send" size={16} /> Submit Design Request
    </button>
  </form>

  <!-- Success state -->
  <div id="request-success" class="hidden mt-6">
    <div class="card p-6 sm:p-8 border-l-4" style="border-left-color:var(--primary)">
      <div class="flex items-start gap-4">
        <span class="grid place-items-center h-10 w-10 rounded-full text-white shrink-0" style="background-image:linear-gradient(135deg,var(--primary),var(--secondary))">
          <Icon name="check" size={20} strokeWidth={3} />
        </span>
        <div>
          <p class="font-semibold t-strong text-lg">Your design request has been received.</p>
          <p class="mt-2 text-sm t-soft leading-relaxed">
            We'll review your details and prepare your design proposal. You can expect to hear from us within 3–5 business days.
          </p>
          <p class="mt-3 text-sm t-muted">
            Questions? Email <a href="mailto:myobokuai@gmail.com" class="text-[color:var(--primary)] hover:underline font-medium">myobokuai@gmail.com</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
