---
import Icon from "../Icon.astro";
const fiverr = "https://www.fiverr.com";

const lines = [
  { n: 1, html: '<span class="text-violet-300">def</span> <span class="text-sky-300">login</span>(email, password):' },
  { n: 2, html: '    user = db.<span class="text-sky-300">find</span>(email)' },
  { n: 3, html: '    <span class="text-violet-300">if not</span> user <span class="text-violet-300">or not</span> <span class="text-sky-300">verify</span>(pw, user.hash):' },
  { n: 4, html: '        <span class="text-violet-300">raise</span> <span class="text-amber-300">AuthError</span>(<span class="text-emerald-300">"Invalid credentials"</span>)' },
  { n: 5, html: '    <span class="text-emerald-300">return</span> <span class="text-sky-300">issue_token</span>(user)', ai: true },
];
---

<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div class="absolute inset-0 -z-10 grid-bg"></div>
  <div class="orb -z-10" style="top:-8%;left:12%;width:400px;height:400px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
  <div class="orb -z-10" style="top:6%;right:8%;width:340px;height:340px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>

  <div class="container-page grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <!-- Copy -->
    <div data-reveal>
      <span class="chip mb-5"><Icon name="code" size={14} /> AI Coding Experts</span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
        Ship faster with <span class="gradient-text">AI coding experts</span>
      </h1>
      <p class="mt-6 text-lg t-soft leading-relaxed max-w-xl">
        Hire vetted developers who pair AI with engineering craft - to build features, review code, fix bugs and ship production-ready software at startup speed.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <a href={fiverr} target="_blank" rel="noopener nofollow" class="btn btn-gradient w-full sm:w-auto">
          Hire an AI coding expert
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#services" class="btn btn-ghost w-full sm:w-auto">
          <Icon name="play" size={16} /> Browse top services
        </a>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm t-muted">
        <span class="inline-flex items-center gap-1.5">
          {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={15} class="text-amber-400" />)}
          <span class="t-strong font-semibold ml-1">4.9/5</span> avg rating
        </span>
        <span class="inline-flex items-center gap-1.5"><Icon name="code" size={15} /> 3,000+ projects shipped</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="shield-check" size={15} /> Code under NDA</span>
      </div>
    </div>

    <!-- Code editor visual -->
    <div class="relative" data-reveal>
      <div class="absolute -right-3 -top-3 z-20 animate-floaty">
        <div class="glass rounded-2xl border b-base p-3 shadow-xl flex items-center gap-2.5">
          <span class="grid place-items-center h-9 w-9 rounded-lg text-white" style="background-image:linear-gradient(135deg,var(--secondary),var(--primary))"><Icon name="git-branch" size={18} /></span>
          <div class="leading-tight">
            <p class="text-xs t-muted">Pull request</p>
            <p class="text-sm font-semibold t-strong"><span class="text-emerald-500">+24</span> <span class="text-rose-400">−3</span></p>
          </div>
        </div>
      </div>

      <div class="card p-2 shadow-2xl overflow-hidden">
        <!-- editor window -->
        <div class="rounded-xl overflow-hidden" style="background:#0b1020">
          <!-- title bar -->
          <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10">
            <span class="h-3 w-3 rounded-full bg-rose-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
            <span class="ml-2 font-mono text-xs text-slate-400">auth.py</span>
            <span class="ml-auto inline-flex items-center gap-1 rounded-md bg-white/10 px-2 py-0.5 text-[0.65rem] font-semibold text-violet-200">
              <Icon name="sparkles" size={11} /> AI
            </span>
          </div>
          <!-- code -->
          <div class="px-4 py-4 font-mono text-[13px] leading-6">
            {lines.map((l) => (
              <div class:list={["flex gap-4", l.ai && "rounded-md bg-emerald-400/10 -mx-2 px-2 ring-1 ring-emerald-400/20"]}>
                <span class="select-none text-slate-600 w-4 text-right">{l.n}</span>
                <span class="text-slate-200 flex-1" set:html={l.html}></span>
                {l.ai && (
                  <span class="ml-auto self-center inline-flex items-center gap-1 rounded bg-emerald-400/15 px-1.5 py-0.5 text-[0.6rem] font-semibold text-emerald-300">
                    <Icon name="sparkles" size={9} /> Tab
                  </span>
                )}
              </div>
            ))}
          </div>
          <!-- status bar -->
          <div class="flex items-center justify-between px-4 py-2.5 border-t border-white/10 text-[0.7rem] text-slate-400">
            <span class="inline-flex items-center gap-1.5"><Icon name="check" size={12} class="text-emerald-400" strokeWidth={3} /> 3 tests passed</span>
            <span class="inline-flex items-center gap-1.5"><Icon name="sparkles" size={11} class="text-violet-300" /> AI suggested 1 line</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
