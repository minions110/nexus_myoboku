---
import Icon from "../Icon.astro";

const faqs = [
  { q: "What are AI design services?", a: "AI design services pair expert designers with AI tools to create graphics, logos, UI and 3D work faster and more affordably. The designer brings creative direction and polish, while AI accelerates ideation, variations and production." },
  { q: "How much do AI design services cost?", a: "Logos often start around $45, graphic design from $25, UI design from $120, and 3D work from $90. Final pricing depends on scope, revisions and deliverables - most experts offer clear packages up front." },
  { q: "How fast is delivery?", a: "Simple assets like logos or social graphics often arrive in 24-72 hours. Larger projects - full UI or 3D sets - typically take a few days to a couple of weeks. You'll get a timeline before work begins." },
  { q: "Do I get source and editable files?", a: "Yes. You receive production-ready files - vector sources (SVG, AI, PDF), layered design files (Figma, PSD) and exports in the formats you need - so your team can keep editing." },
  { q: "Can designers match my brand style?", a: "Absolutely. Share your brand guidelines, colors, fonts and references, and the designer will produce on-brand work. AI helps generate on-style variations quickly for fast feedback." },
  { q: "Who owns the designs?", a: "You do. Once a project is complete and paid for, full commercial rights and ownership transfer to you - so you're free to use the work anywhere without restrictions." },
];
---

<section id="faq" class="py-24 sm:py-32 bg-soft border-y b-base">
  <div class="container-page">
    <div class="max-w-2xl mx-auto text-center" data-reveal>
      <span class="chip mb-4 mx-auto"><Icon name="search" size={14} /> FAQ</span>
      <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
        Frequently asked questions
      </h2>
      <p class="mt-4 text-lg t-soft">Everything you need to know before you hire.</p>
    </div>

    <div class="mt-12 mx-auto max-w-3xl space-y-3" data-reveal>
      {faqs.map((f) => (
        <details class="faq-item card group overflow-hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 sm:p-6 list-none">
            <span class="text-base sm:text-lg font-semibold t-strong">{f.q}</span>
            <span class="grid place-items-center h-8 w-8 shrink-0 rounded-full border b-strong t-soft transition-transform duration-300 group-open:rotate-45">
              <Icon name="plus" size={16} />
            </span>
          </summary>
          <div class="px-5 sm:px-6 pb-5 sm:pb-6 -mt-1 text-sm sm:text-base t-soft leading-relaxed">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] { border-color: var(--border-strong); }
</style>
