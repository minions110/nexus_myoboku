---
import Icon from "../Icon.astro";
const fiverr = "https://www.fiverr.com";
---

<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div class="absolute inset-0 -z-10 grid-bg"></div>
  <div class="orb -z-10" style="top:-8%;left:14%;width:400px;height:400px;background:radial-gradient(circle,#8b5cf6,transparent 70%)"></div>
  <div class="orb -z-10" style="top:8%;right:8%;width:340px;height:340px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>

  <div class="container-page grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <!-- Copy -->
    <div data-reveal>
      <span class="chip mb-5"><Icon name="palette" size={14} /> AI Design Services</span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
        Design that stands out, <span class="gradient-text">powered by AI</span>
      </h1>
      <p class="mt-6 text-lg t-soft leading-relaxed max-w-xl">
        Hire vetted AI design experts for graphics, logos, UI and 3D - premium creative work, in your brand style, delivered at startup speed.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <a href={fiverr} target="_blank" rel="noopener nofollow" class="btn btn-gradient w-full sm:w-auto">
          Hire a designer
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#graphic" class="btn btn-ghost w-full sm:w-auto">
          <Icon name="play" size={16} /> View services
        </a>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm t-muted">
        <span class="inline-flex items-center gap-1.5">
          {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={15} class="text-amber-400" />)}
          <span class="t-strong font-semibold ml-1">4.9/5</span> avg rating
        </span>
        <span class="inline-flex items-center gap-1.5"><Icon name="palette" size={15} /> 5,000+ designs delivered</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="shield-check" size={15} /> Money-back guarantee</span>
      </div>
    </div>

    <!-- Moodboard visual -->
    <div class="relative" data-reveal>
      <div class="grid grid-cols-2 gap-4">
        <!-- Logo mark -->
        <div class="aspect-square rounded-2xl grid place-items-center text-white shadow-xl rotate-[-3deg]" style="background:linear-gradient(135deg,#4f46e5,#8b5cf6)">
          <Icon name="sparkles" size={48} strokeWidth={1.8} />
        </div>
        <!-- Graphic poster -->
        <div class="aspect-square rounded-2xl shadow-xl rotate-[3deg] overflow-hidden relative" style="background:linear-gradient(160deg,#06b6d4,#4f46e5)">
          <div class="absolute -right-4 -top-4 h-20 w-20 rounded-full bg-white/25 blur-md"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="h-2.5 w-3/4 rounded bg-white/80"></div>
            <div class="mt-2 h-2.5 w-1/2 rounded bg-white/40"></div>
          </div>
        </div>
        <!-- UI snippet -->
        <div class="aspect-square rounded-2xl shadow-xl rotate-[3deg] overflow-hidden card p-3">
          <div class="flex items-center justify-between">
            <div class="h-2 w-12 rounded bg-surface-2"></div>
            <div class="h-5 w-5 rounded-full" style="background:linear-gradient(135deg,var(--primary),var(--accent))"></div>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            {[0, 1].map(() => <div class="h-10 rounded-lg bg-surface-2"></div>)}
          </div>
          <div class="mt-2 flex items-end gap-1 h-10">
            {[50, 75, 45, 90, 60].map((h) => <div class="flex-1 rounded-t" style={`height:${h}%;background:linear-gradient(180deg,var(--primary),var(--accent))`}></div>)}
          </div>
        </div>
        <!-- 3D orb -->
        <div class="aspect-square rounded-2xl shadow-xl rotate-[-3deg] grid place-items-center relative overflow-hidden" style="background:linear-gradient(160deg,#0b1020,#1e1b4b)">
          <div class="h-20 w-20 rounded-full shadow-2xl" style="background:radial-gradient(circle at 32% 28%, #ffffff, #c7d2fe 18%, #8b5cf6 55%, #2e1065 100%)"></div>
          <div class="absolute top-4 right-5 h-7 w-7 rounded-lg rotate-12" style="background:radial-gradient(circle at 30% 25%, #ffffff, #06b6d4 60%, #0e7490)"></div>
        </div>
      </div>
      <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 z-20">
        <div class="glass rounded-2xl border b-base px-4 py-2.5 shadow-xl flex items-center gap-2">
          <Icon name="sparkles" size={16} class="text-[color:var(--primary)]" />
          <span class="text-sm font-semibold t-strong">4 disciplines, one studio</span>
        </div>
      </div>
    </div>
  </div>
</section>
