---
import Icon from "../Icon.astro";
import { getAllTools, getAllCategories } from "../../data";

const tools = getAllTools();
const categories = getAllCategories();
const avgRating = (tools.reduce((sum, t) => sum + t.rating, 0) / tools.length).toFixed(1);

const stats = [
  { value: `${tools.length}`, label: "AI tools" },
  { value: `${categories.length}`, label: "Categories" },
  { value: avgRating, label: "Avg rating" },
];
---

<section id="top" class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div class="absolute inset-0 -z-10 grid-bg"></div>
  <div class="orb -z-10" style="top:-8%;left:12%;width:420px;height:420px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
  <div class="orb -z-10 animate-pulse-glow" style="top:6%;right:8%;width:380px;height:380px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>
  <div class="orb -z-10" style="top:42%;left:42%;width:340px;height:340px;background:radial-gradient(circle,#8b5cf6,transparent 70%)"></div>

  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <span class="chip mx-auto mb-6">
        <span class="grid place-items-center h-4 w-4 rounded-full text-white" style="background-image:linear-gradient(135deg,var(--primary),var(--secondary))">
          <Icon name="sparkles" size={11} strokeWidth={2.5} />
        </span>
        {tools.length} curated AI tools, reviewed by engineers
      </span>

      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight">
        Discover the best <span class="gradient-text">AI tools</span> for every workflow
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg t-soft leading-relaxed">
        Compare, choose, and ship with hand-picked AI tools - chat assistants, coding copilots, image and video generators, and more. Vetted by engineers and updated weekly.
      </p>

      <form action="/tools" method="get" role="search" class="mx-auto mt-8 max-w-xl" data-reveal>
        <div class="flex items-center gap-2 rounded-2xl border b-strong bg-surface px-4 py-2.5 shadow-sm transition-colors focus-within:border-[color:var(--primary)]">
          <Icon name="search" size={20} class="t-muted shrink-0" />
          <input
            name="q"
            type="search"
            placeholder="Search AI tools by name or use case..."
            autocomplete="off"
            aria-label="Search AI tools"
            class="w-full bg-transparent text-base t-strong placeholder:t-muted outline-none"
          />
          <button type="submit" class="btn btn-gradient shrink-0 !px-4 !py-2 text-sm">
            <Icon name="search" size={16} />
            <span class="hidden sm:inline">Search</span>
          </button>
        </div>
      </form>

      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/tools" class="btn btn-gradient w-full sm:w-auto">
          Explore AI Tools
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/products" class="btn btn-ghost w-full sm:w-auto">
          <Icon name="sparkles" size={18} />
          Explore AI Products
        </a>
        <a href="#categories" class="btn btn-ghost w-full sm:w-auto">
          <Icon name="layout-dashboard" size={18} />
          Browse Categories
        </a>
      </div>

      <div class="mx-auto mt-12 grid max-w-md grid-cols-3 gap-4">
        {stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-2xl sm:text-3xl font-bold t-strong">{s.value}</p>
            <p class="mt-1 text-xs t-muted">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
