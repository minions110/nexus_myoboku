---
import Icon from "../Icon.astro";
import { getAllServices } from "../../data";

const services = getAllServices();
---

<section id="services" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <span class="chip mb-4"><Icon name="layers" size={14} /> Services</span>
      <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
        Featured <span class="gradient-text">AI services</span>
      </h2>
      <p class="mt-4 text-lg t-soft">
        Looking for a team, not just a tool? Explore vetted AI service categories - from coding to automation - delivered by specialists.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <a
          href={s.href}
          data-reveal
          style={`transition-delay:${i * 50}ms`}
          class="card card-hover group flex flex-col p-6"
        >
          <span
            class="grid h-12 w-12 place-items-center rounded-xl text-white"
            style={`background-image:linear-gradient(135deg, ${s.accent}, color-mix(in oklab, ${s.accent} 60%, #8b5cf6))`}
          >
            <Icon name={s.icon} size={24} />
          </span>
          <h3 class="mt-5 text-lg font-semibold t-strong">{s.name}</h3>
          <p class="text-xs t-muted">{s.tagline}</p>
          <p class="mt-2 text-sm t-soft leading-relaxed flex-1">{s.description}</p>
          <ul class="mt-4 space-y-1.5">
            {s.highlights.map((h) => (
              <li class="flex items-center gap-2 text-sm t-soft">
                <Icon name="check" size={14} class="text-[color:var(--primary)]" /> {h}
              </li>
            ))}
          </ul>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--primary)]">
            Explore {s.name}
            <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
