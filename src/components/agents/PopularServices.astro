---
import Icon from "../Icon.astro";
import ServiceCover from "../ServiceCover.astro";
const fiverr = "https://www.fiverr.com";

const services = [
  { name: "Custom AI Agent Development", icon: "bot", hue: 250, price: "$300", desc: "Purpose-built agents designed for your exact workflow and goals." },
  { name: "Multi-Agent Systems", icon: "network", hue: 280, price: "$900", desc: "Teams of collaborating agents that divide and conquer complex objectives." },
  { name: "Agent Integration", icon: "plug", hue: 190, price: "$250", desc: "Connect agents into your existing apps, APIs and tech stack." },
  { name: "RAG Agents", icon: "database", hue: 160, price: "$400", desc: "Agents that reason over your private knowledge base and documents." },
  { name: "Workflow Automation Agents", icon: "workflow", hue: 330, price: "$350", desc: "Agents that run, monitor and maintain your automations autonomously." },
  { name: "Agent Maintenance & Eval", icon: "refresh-cw", hue: 200, price: "$200/mo", desc: "Ongoing monitoring, evals and continuous improvement for production agents." },
];
---

<section id="services" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <span class="chip mb-4"><Icon name="star" size={14} /> Popular services</span>
      <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
        Most-requested AI agent services
      </h2>
      <p class="mt-4 text-lg t-soft">
        From a single custom agent to full multi-agent systems - hire a developer for any of these.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <article class="card card-hover group overflow-hidden flex flex-col" data-reveal style={`transition-delay:${i * 55}ms`}>
          <ServiceCover hue={s.hue} icon={s.icon} name={s.name} />
          <div class="p-6 flex flex-col flex-1">
            <h3 class="text-lg font-semibold t-strong">{s.name}</h3>
            <p class="mt-2 text-sm t-soft leading-relaxed flex-1">{s.desc}</p>
            <div class="mt-5 flex items-center justify-between border-t b-base pt-4">
              <div>
                <p class="text-xs t-muted">From</p>
                <p class="font-display text-xl font-bold t-strong">{s.price}</p>
              </div>
              <a href={fiverr} target="_blank" rel="noopener nofollow" class="btn btn-ghost !px-4 !py-2.5 !text-sm group-hover:!border-[color:var(--primary)]">
                Get started
                <Icon name="arrow-up-right" size={15} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
