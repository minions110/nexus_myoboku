---
import Icon from "../Icon.astro";
import PricingBadge from "./PricingBadge.astro";
import RatingStars from "./RatingStars.astro";
import type { Tool } from "../../data";
import { getCategoryBySlug } from "../../data";

interface Props {
  tool: Tool;
  rank?: number;
  showDate?: boolean;
  class?: string;
}

const { tool, rank, showDate = false, class: className = "" } = Astro.props;
const category = getCategoryBySlug(tool.category);
const hue = [...tool.slug].reduce((acc, c) => acc + c.charCodeAt(0), 0) % 360;
const date = tool.lastUpdated
  ? new Date(tool.lastUpdated).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : "";
---

<a
  href={`/tools/${tool.slug}`}
  class={`tool-row card card-hover group flex items-center gap-4 p-4 ${className}`}
>
  {rank != null && (
    <span
      class="grid h-9 w-9 shrink-0 place-items-center rounded-xl font-display text-base font-bold"
      style="background:color-mix(in oklab, var(--primary) 12%, var(--surface));color:var(--primary)"
    >
      {rank}
    </span>
  )}

  <span
    class="relative grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-xl font-display text-base font-bold text-white"
    style={`background-image:linear-gradient(135deg,hsl(${hue} 70% 55%),hsl(${(hue + 40) % 360} 70% 45%))`}
  >
    {tool.name.charAt(0)}
    <img
      src={tool.logo}
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
      onerror="this.remove()"
    />
  </span>

  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <h3 class="font-display font-semibold t-strong truncate transition-colors group-hover:text-[color:var(--primary)]">
        {tool.name}
      </h3>
      <PricingBadge pricing={tool.pricing} />
    </div>
    <p class="mt-0.5 line-clamp-1 text-sm t-soft">{tool.shortDescription}</p>
  </div>

  <div class="hidden sm:flex shrink-0 flex-col items-end gap-1.5">
    <RatingStars rating={tool.rating} size={13} />
    <span class="text-xs t-muted">{showDate ? date : (category?.name ?? tool.category)}</span>
  </div>
</a>
