---
import Icon from "../Icon.astro";
import PricingBadge from "./PricingBadge.astro";
import RatingStars from "./RatingStars.astro";
import type { Tool } from "../../data";
import { getCategoryBySlug } from "../../data";

interface Props {
  tool: Tool;
  class?: string;
}

const { tool, class: className = "" } = Astro.props;
const category = getCategoryBySlug(tool.category);
const hue = [...tool.slug].reduce((acc, c) => acc + c.charCodeAt(0), 0) % 360;
const search = [tool.name, tool.developer, tool.shortDescription, tool.category, ...tool.tags]
  .join(" ")
  .toLowerCase();
---

<a
  href={`/tools/${tool.slug}`}
  data-category={tool.category}
  data-search={search}
  class={`tool-card card card-hover group flex flex-col p-5 ${className}`}
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="relative grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-xl font-display text-lg font-bold text-white"
      style={`background-image:linear-gradient(135deg,hsl(${hue} 70% 55%),hsl(${(hue + 40) % 360} 70% 45%))`}
    >
      {tool.name.charAt(0)}
      <img
        src={tool.logo}
        alt=""
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
        onerror="this.remove()"
      />
    </span>

    <div class="flex flex-col items-end gap-1.5">
      {tool.featured && (
        <span
          class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold text-white"
          style="background-image:linear-gradient(135deg,var(--primary),var(--accent))"
        >
          <Icon name="star" size={11} class="fill-current" /> Featured
        </span>
      )}
      <PricingBadge pricing={tool.pricing} />
    </div>
  </div>

  <h3 class="mt-4 font-display text-lg font-bold t-strong transition-colors group-hover:text-[color:var(--primary)]">
    {tool.name}
  </h3>
  <p class="text-xs t-muted">by {tool.developer}</p>
  <p class="mt-2 line-clamp-2 text-sm t-soft leading-relaxed">{tool.shortDescription}</p>

  <div class="mt-4 flex items-center justify-between border-t b-base pt-3">
    <RatingStars rating={tool.rating} size={13} />
    <span class="inline-flex items-center gap-1 text-xs t-muted">
      <Icon name={category?.icon ?? "box"} size={13} /> {category?.name ?? tool.category}
    </span>
  </div>
</a>
