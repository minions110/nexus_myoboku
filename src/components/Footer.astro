---
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Navigation",
    links: [
      { label: "Home", href: "/" },
      { label: "Services", href: "/services" },
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "AI Tools", href: "/tools" },
      { label: "AI Automation", href: "/ai-automation" },
      { label: "AI Agents", href: "/ai-agents" },
      { label: "AI Coding", href: "/ai-coding" },
      { label: "AI Design", href: "/ai-design" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Affiliate Disclosure", href: "/affiliate-disclosure" },
    ],
  },
];

const socials = [
  { icon: "twitter", label: "Twitter / X", href: "#" },
  { icon: "github", label: "GitHub", href: "#" },
  { icon: "linkedin", label: "LinkedIn", href: "#" },
];
---

<footer class="relative overflow-hidden border-t b-base bg-soft">
  <!-- Gradient hairline -->
  <div class="absolute inset-x-0 top-0 h-px" style="background-image:linear-gradient(90deg,transparent,var(--primary),var(--accent),var(--secondary),transparent)"></div>
  <div class="orb" style="bottom:-45%;left:-6%;width:440px;height:440px;background:radial-gradient(circle,var(--primary),transparent 70%);opacity:.07"></div>

  <div class="container-page relative py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 font-display font-bold text-lg t-strong">
          <span class="grid place-items-center h-9 w-9 rounded-xl text-white shadow-lg" style="background-image:linear-gradient(135deg,var(--primary),var(--accent));box-shadow:0 8px 22px -8px color-mix(in oklab,var(--primary) 70%,transparent)">
            <Icon name="sparkles" size={18} strokeWidth={2.2} />
          </span>
          Nexus
        </a>
        <p class="mt-4 max-w-xs text-sm t-muted leading-relaxed">
          The AI resource hub for modern builders. Curated, benchmarked and maintained by engineers.
        </p>
        <div class="mt-5 flex items-center gap-2">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label} class="social-ico grid place-items-center h-10 w-10 rounded-xl border b-strong bg-surface t-soft transition-all duration-200 hover:border-transparent hover:text-white">
              <Icon name={s.icon} size={18} />
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-[0.08em] t-muted">{col.title}</h4>
          <ul class="mt-4 space-y-3">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="inline-flex items-center text-sm t-muted hover:t-strong hover:translate-x-1 transition-all duration-200">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t b-base pt-8">
      <p class="text-sm t-muted">© {year} Nexus. Built for builders, worldwide.</p>
      <div class="flex items-center gap-5 text-sm t-muted">
        <span class="inline-flex items-center gap-1.5"><Icon name="globe" size={15} /> English (Global)</span>
        <button id="footer-top" type="button" class="inline-flex items-center gap-1.5 hover:t-strong transition-colors">
          Back to top <Icon name="arrow-right" size={15} class="-rotate-90" />
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .social-ico:hover {
    background-image: linear-gradient(135deg, var(--primary), var(--accent));
    box-shadow: 0 10px 24px -12px color-mix(in oklab, var(--primary) 75%, transparent);
  }
</style>

<script>
  document.getElementById("footer-top")?.addEventListener("click", () =>
    window.scrollTo({ top: 0, behavior: "smooth" })
  );
</script>
