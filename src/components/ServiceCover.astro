---
import Icon from "./Icon.astro";
interface Props {
  hue: number;
  icon: string;
  name: string;
}
const { hue, icon, name } = Astro.props;
const hue2 = (hue + 48) % 360;
---

<div
  class="relative h-40 w-full overflow-hidden"
  style={`background:linear-gradient(135deg,hsl(${hue} 82% 58%),hsl(${hue2} 74% 54%))`}
>
  <!-- grid overlay -->
  <div
    class="absolute inset-0 opacity-[0.18]"
    style="background-image:linear-gradient(rgba(255,255,255,.6) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.6) 1px,transparent 1px);background-size:26px 26px"
  ></div>
  <!-- glow orb -->
  <div class="absolute -right-7 -top-7 h-28 w-28 rounded-full bg-white/30 blur-2xl"></div>
  <div class="absolute -left-6 bottom-0 h-20 w-20 rounded-full bg-black/10 blur-2xl"></div>
  <!-- watermark icon -->
  <Icon name={icon} size={130} strokeWidth={1.1} class="absolute -right-3 -bottom-7 text-white/15" />
  <!-- brand tile -->
  <span class="absolute left-4 bottom-4 grid place-items-center h-11 w-11 rounded-xl font-display font-bold text-lg text-white ring-1 ring-white/40"
    style="background:rgba(255,255,255,0.18);backdrop-filter:blur(6px)">{name.charAt(0)}</span>
</div>
