---
import Icon from "../Icon.astro";

const reassurances = [
  { icon: "clock", t: "Fast replies", d: "We respond to most messages within 1-2 business days." },
  { icon: "shield-check", t: "Private & secure", d: "Your details are never shared or sold - ever." },
  { icon: "headphones", t: "Real humans", d: "No bots - every message is read by our team." },
];
const topics = ["General question", "Feedback", "Bug report", "Partnership", "Press"];
const field = "mt-1.5 w-full rounded-lg border b-strong bg-surface px-3.5 py-2.5 text-sm t-strong placeholder:t-muted outline-none focus:border-[color:var(--primary)] transition-colors";
---

<section id="contact-form" class="py-24 sm:py-32 bg-soft border-y b-base">
  <div class="container-page">
    <div class="grid lg:grid-cols-[1fr_1.3fr] gap-10 lg:gap-14 items-start">
      <div data-reveal>
        <span class="chip mb-4"><Icon name="send" size={14} /> Contact form</span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">Send us a message</h2>
        <p class="mt-4 text-lg t-soft leading-relaxed">
          The quickest way to reach us. Tell us what's on your mind and we'll get back to you by email.
        </p>
        <div class="mt-8 space-y-4">
          {reassurances.map((r) => (
            <div class="flex items-start gap-3.5">
              <span class="icon-tile h-11 w-11 shrink-0"><Icon name={r.icon} size={22} /></span>
              <div>
                <p class="font-semibold t-strong">{r.t}</p>
                <p class="text-sm t-soft leading-relaxed">{r.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card p-6 sm:p-8" data-reveal>
        <form data-form data-success="form-success" class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium t-soft">Name</span>
              <input required type="text" placeholder="Jane Builder" class={field} />
            </label>
            <label class="block">
              <span class="text-sm font-medium t-soft">Email</span>
              <input required type="email" placeholder="you@company.com" class={field} />
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-medium t-soft">Topic</span>
            <select required class={field}>
              {topics.map((t) => <option>{t}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium t-soft">Message</span>
            <textarea required rows="6" placeholder="How can we help?" class={`${field} resize-y`}></textarea>
          </label>
          <button type="submit" class="btn btn-gradient w-full sm:w-auto">
            <Icon name="send" size={16} /> Send message
          </button>
        </form>
        <div id="form-success" class="hidden items-center gap-3 rounded-xl border b-base bg-surface-2 p-5">
          <span class="grid place-items-center h-10 w-10 rounded-full text-white shrink-0" style="background-image:linear-gradient(135deg,var(--primary),var(--secondary))">
            <Icon name="check" size={20} strokeWidth={3} />
          </span>
          <div>
            <p class="font-semibold t-strong">Thanks - message sent!</p>
            <p class="text-sm t-muted">We'll get back to you within 1-2 business days.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
