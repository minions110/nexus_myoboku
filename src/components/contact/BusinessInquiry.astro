---
import Icon from "../Icon.astro";

const checklist = [
  "A short intro to your company or product",
  "What you're proposing and your goals",
  "Timeline, scope and any budget range",
  "A link or deck if you have one",
];
const field = "mt-1.5 w-full rounded-lg border border-white/25 bg-white/10 px-3.5 py-2.5 text-sm text-white placeholder:text-white/50 outline-none focus:border-white transition-colors";
---

<section id="business" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-[1.75rem] p-8 sm:p-12 lg:p-16 text-white shadow-2xl"
      style="background-image:linear-gradient(135deg,#4f46e5,#8b5cf6 55%,#06b6d4)">
      <div class="absolute inset-0 opacity-25" style="background-image:linear-gradient(rgba(255,255,255,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.2) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(ellipse 70% 80% at 50% 50%,#000,transparent 75%)"></div>

      <div class="relative grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div data-reveal>
          <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">
            <Icon name="network" size={13} /> Business inquiry
          </span>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl font-bold tracking-tight">Partner with Nexus</h2>
          <p class="mt-4 text-white/85 leading-relaxed">
            From sponsorships and integrations to co-marketing and enterprise listings - let's build something together. Tell us about your company and we'll take it from there.
          </p>
          <ul class="mt-6 space-y-2.5">
            {checklist.map((c) => (
              <li class="flex items-start gap-2.5 text-sm text-white/90">
                <span class="grid place-items-center h-5 w-5 rounded-full bg-white/20 shrink-0 mt-0.5">
                  <Icon name="check" size={13} strokeWidth={3} />
                </span>
                {c}
              </li>
            ))}
          </ul>
          <a href="mailto:partners@nexus.ai" class="btn bg-white text-[color:var(--primary-600)] hover:bg-white/90 mt-8">
            <Icon name="mail" size={16} /> partners@nexus.ai
          </a>
        </div>

        <div class="rounded-2xl bg-white/10 backdrop-blur p-6 sm:p-8 border border-white/20" data-reveal>
          <form data-form data-success="biz-success" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <label class="block">
                <span class="text-sm font-medium text-white/80">Company</span>
                <input required type="text" placeholder="Acme AI" class={field} />
              </label>
              <label class="block">
                <span class="text-sm font-medium text-white/80">Website</span>
                <input type="url" placeholder="acme.ai" class={field} />
              </label>
            </div>
            <label class="block">
              <span class="text-sm font-medium text-white/80">Budget range</span>
              <select required class={field}>
                <option class="text-black">Under $5K</option>
                <option class="text-black">$5K - $25K</option>
                <option class="text-black">$25K - $100K</option>
                <option class="text-black">$100K+</option>
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-medium text-white/80">Message</span>
              <textarea required rows="4" placeholder="What are you proposing?" class={`${field} resize-y`}></textarea>
            </label>
            <button type="submit" class="btn bg-white text-[color:var(--primary-600)] hover:bg-white/90 w-full">
              <Icon name="send" size={16} /> Submit inquiry
            </button>
          </form>
          <div id="biz-success" class="hidden items-center gap-3 rounded-xl bg-white/15 p-5">
            <span class="grid place-items-center h-10 w-10 rounded-full bg-white/25 shrink-0">
              <Icon name="check" size={20} strokeWidth={3} />
            </span>
            <div>
              <p class="font-semibold">Inquiry received!</p>
              <p class="text-sm text-white/80">Our partnerships team will be in touch shortly.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
