---
import Icon from "../Icon.astro";
const fiverr = "https://www.fiverr.com";

const experts = [
  {
    name: "Maya R.",
    title: "AI Workflow Automation",
    level: "Top Rated",
    rating: 4.9,
    reviews: 1240,
    price: 45,
    hue: 250,
    tags: ["Zapier", "Make", "GPT-4"],
  },
  {
    name: "David K.",
    title: "Custom AI Agents",
    level: "Pro",
    rating: 4.8,
    reviews: 890,
    price: 80,
    hue: 190,
    tags: ["n8n", "LangChain", "Python"],
  },
  {
    name: "Sofia L.",
    title: "Business Process AI",
    level: "Top Rated",
    rating: 5.0,
    reviews: 2103,
    price: 60,
    hue: 330,
    tags: ["Airtable", "OpenAI", "APIs"],
  },
];
---

<section id="experts" class="py-24 sm:py-32 bg-soft border-y b-base">
  <div class="container-page">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6" data-reveal>
      <div class="max-w-2xl">
        <span class="chip mb-4"><Icon name="badge-check" size={14} /> Featured Fiverr experts</span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
          Hire a vetted AI automation pro
        </h2>
        <p class="mt-4 text-lg t-soft">
          Hand-picked, top-rated Fiverr freelancers ready to design, build and maintain your automations.
        </p>
      </div>
      <a href={fiverr} target="_blank" rel="noopener nofollow" class="btn btn-ghost shrink-0">
        View all experts <Icon name="arrow-right" size={17} />
      </a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {experts.map((e, i) => (
        <article class="card card-hover group overflow-hidden flex flex-col" data-reveal style={`transition-delay:${i * 70}ms`}>
          <!-- Cover -->
          <div class="relative h-24 overflow-hidden" style={`background:linear-gradient(135deg,hsl(${e.hue} 80% 58%),hsl(${(e.hue + 45) % 360} 75% 54%))`}>
            <div class="absolute inset-0 opacity-20" style="background-image:linear-gradient(rgba(255,255,255,.6) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.6) 1px,transparent 1px);background-size:24px 24px"></div>
            <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-[0.7rem] font-semibold text-slate-800">
              <Icon name="badge-check" size={12} class="text-[color:var(--primary)]" /> {e.level}
            </span>
          </div>

          <div class="px-6 pb-6 flex flex-col flex-1 -mt-8">
            <!-- Avatar -->
            <span class="grid place-items-center h-16 w-16 rounded-2xl font-display font-bold text-xl text-white ring-4 ring-[color:var(--surface)]"
              style={`background-image:linear-gradient(135deg,hsl(${e.hue} 80% 58%),hsl(${(e.hue + 45) % 360} 80% 60%))`}>
              {e.name.charAt(0)}
            </span>

            <div class="mt-3 flex items-center justify-between gap-2">
              <h3 class="text-lg font-semibold t-strong">{e.name}</h3>
              <span class="inline-flex items-center gap-1 text-sm">
                <Icon name="star" size={14} class="text-amber-400" />
                <span class="font-semibold t-strong">{e.rating.toFixed(1)}</span>
                <span class="t-muted">({e.reviews.toLocaleString("en-US")})</span>
              </span>
            </div>
            <p class="text-sm t-muted">{e.title}</p>

            <div class="mt-3 flex flex-wrap gap-1.5">
              {e.tags.map((t) => <span class="chip !py-1 !text-xs">{t}</span>)}
            </div>

            <div class="mt-5 flex items-center justify-between border-t b-base pt-4">
              <div>
                <p class="text-xs t-muted">From</p>
                <p class="font-display text-xl font-bold t-strong">${e.price}</p>
              </div>
              <a href={fiverr} target="_blank" rel="noopener nofollow" class="btn btn-gradient !px-4 !py-2.5 !text-sm">
                Hire on Fiverr
                <Icon name="arrow-up-right" size={15} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm t-muted">
      Explore <span class="t-strong font-semibold">500+ AI automation experts</span> on Fiverr - most respond within 24 hours.
    </p>
  </div>
</section>
