---
import Icon from "../Icon.astro";

const benefits = [
  { icon: "clock", title: "Save 20+ hours/week", desc: "Reclaim the time your team loses to repetitive manual tasks every week.", stat: "20h+" },
  { icon: "banknote", title: "Cut operational costs", desc: "Get more done without expanding headcount or paying for overtime.", stat: "−60%" },
  { icon: "trending-up", title: "Scale effortlessly", desc: "Handle 10x the volume without breaking a sweat or dropping quality.", stat: "10x" },
  { icon: "refresh-cw", title: "Run 24/7", desc: "Workflows never sleep - they keep working nights, weekends and holidays.", stat: "24/7" },
  { icon: "shield-check", title: "Reduce errors", desc: "Consistent, auditable outputs every single time, with full visibility.", stat: "99.9%" },
  { icon: "headphones", title: "Free your team", desc: "Let people focus on creative, high-impact work instead of copy-paste.", stat: "Focus" },
];
---

<section id="benefits" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="max-w-2xl mx-auto text-center" data-reveal>
      <span class="chip mb-4 mx-auto"><Icon name="zap" size={14} /> Benefits</span>
      <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
        Why teams automate with AI
      </h2>
      <p class="mt-4 text-lg t-soft">
        Real outcomes, not hype. Here's what happens when busywork runs itself.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b, i) => (
        <div class="card card-hover p-7" data-reveal style={`transition-delay:${i * 55}ms`}>
          <div class="flex items-start justify-between">
            <span class="icon-tile h-12 w-12"><Icon name={b.icon} size={24} /></span>
            <span class="font-display text-2xl font-bold gradient-text">{b.stat}</span>
          </div>
          <h3 class="mt-5 text-lg font-semibold t-strong">{b.title}</h3>
          <p class="mt-2 text-sm t-soft leading-relaxed">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
