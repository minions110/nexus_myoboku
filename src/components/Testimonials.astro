---
import Icon from "./Icon.astro";

const testimonials = [
  {
    quote:
      "Myoboku AI cut our model selection sprint from two weeks to an afternoon. The side-by-side benchmarks are genuinely trustworthy.",
    name: "Aria Chen",
    role: "ML Lead, Quantix",
    hue: 250,
  },
  {
    quote:
      "As a two-person startup, finding the right APIs used to eat days. This is the one tab that stays open while we build.",
    name: "Marco Silva",
    role: "Founder, Helio",
    hue: 190,
  },
  {
    quote:
      "The curation bar is real. Everything listed actually works in production - our team finally stopped chasing dead tools.",
    name: "Riya Patel",
    role: "Staff Engineer, Cobalt",
    hue: 330,
  },
];
---

<section id="testimonials" class="py-24 sm:py-32 bg-soft border-y b-base">
  <div class="container-page">
    <div class="max-w-2xl mx-auto text-center" data-reveal>
      <span class="chip mb-4 mx-auto"><Icon name="users" size={14} /> Community</span>
      <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
        Loved by builders worldwide
      </h2>
      <p class="mt-4 text-lg t-soft">
        From solo founders to scaling engineering teams - here's what people ship with Myoboku AI.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {testimonials.map((t, i) => (
        <figure class="card card-hover p-7 flex flex-col" data-reveal style={`transition-delay:${i * 70}ms`}>
          <Icon name="quote" size={28} class="text-[color:var(--primary)] opacity-30" />
          <blockquote class="mt-3 t-soft leading-relaxed flex-1">"{t.quote}"</blockquote>
          <div class="mt-3 flex items-center gap-0.5 text-amber-400">
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={15} />)}
          </div>
          <figcaption class="mt-5 flex items-center gap-3 border-t b-base pt-5">
            <span class="grid place-items-center h-11 w-11 rounded-full font-semibold text-white"
              style={`background-image:linear-gradient(135deg,hsl(${t.hue} 80% 58%),hsl(${(t.hue + 45) % 360} 80% 60%))`}>
              {t.name.charAt(0)}
            </span>
            <div>
              <p class="text-sm font-semibold t-strong">{t.name}</p>
              <p class="text-xs t-muted">{t.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
