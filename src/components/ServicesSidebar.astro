---
import Icon from "./Icon.astro";

interface CatCount { cat: string; category: string; icon: string; count: number; }
interface Featured {
  name: string;
  category: string;
  rating: number;
  hue: number;
}
interface Props {
  categories: CatCount[];
  featured: Featured[];
}
const { categories, featured } = Astro.props;
---

<aside class="space-y-6 lg:sticky lg:top-24 self-start">
  <!-- Popular Categories -->
  <div class="card p-6">
    <h3 class="flex items-center gap-2 text-sm font-semibold t-strong">
      <Icon name="trending-up" size={16} class="text-[color:var(--primary)]" />
      Popular Categories
    </h3>
    <ul class="mt-4 space-y-1">
      {categories.map((c) => (
        <li>
          <button
            data-filter={c.cat}
            class="sidebar-cat flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-sm t-soft hover:bg-surface-2 hover:t-strong transition-colors"
          >
            <span class="inline-flex items-center gap-2.5">
              <span class="icon-tile h-7 w-7 !rounded-md"><Icon name={c.icon} size={15} /></span>
              {c.category}
            </span>
            <span class="text-xs t-muted">{c.count}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Featured Services -->
  <div class="card p-6">
    <h3 class="flex items-center gap-2 text-sm font-semibold t-strong">
      <Icon name="sparkles" size={16} class="text-[color:var(--primary)]" />
      Featured Services
    </h3>
    <ul class="mt-4 space-y-3">
      {featured.map((f) => (
        <li>
          <a href="#" class="group flex items-center gap-3 rounded-xl p-2 hover:bg-surface-2 transition-colors">
            <span class="grid place-items-center h-11 w-11 shrink-0 rounded-lg font-display font-bold text-white text-sm"
              style={`background-image:linear-gradient(135deg,hsl(${f.hue} 80% 58%),hsl(${(f.hue + 45) % 360} 80% 60%))`}>
              {f.name.charAt(0)}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium t-strong">{f.name}</span>
              <span class="mt-0.5 inline-flex items-center gap-1 text-xs t-muted">
                {f.category}
                <span class="inline-flex items-center gap-0.5">
                  <Icon name="star" size={11} class="text-amber-400" />{f.rating.toFixed(1)}
                </span>
              </span>
            </span>
            <Icon name="arrow-up-right" size={15} class="t-muted group-hover:t-strong transition-colors" />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Newsletter -->
  <div class="card relative overflow-hidden p-6">
    <div class="orb" style="top:-40%;right:-20%;width:180px;height:180px;background:radial-gradient(circle,var(--accent),transparent 70%);opacity:.2"></div>
    <div class="relative">
      <span class="icon-tile h-11 w-11"><Icon name="rocket" size={22} /></span>
      <h3 class="mt-4 text-base font-semibold t-strong">Weekly AI drops</h3>
      <p class="mt-1.5 text-sm t-muted leading-relaxed">
        Get the best new AI services in your inbox every week. No spam.
      </p>
      <form class="mt-4 space-y-2" onsubmit="event.preventDefault();this.reset();">
        <input
          type="email"
          required
          placeholder="you@company.com"
          class="w-full rounded-lg border b-strong bg-surface px-3 py-2.5 text-sm t-strong placeholder:t-muted outline-none focus:border-[color:var(--primary)] transition-colors"
        />
        <button type="submit" class="btn btn-gradient w-full !py-2.5 !text-sm">
          Subscribe
          <Icon name="arrow-right" size={16} />
        </button>
      </form>
    </div>
  </div>
</aside>
