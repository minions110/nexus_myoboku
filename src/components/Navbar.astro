---
import Icon from "./Icon.astro";
import SearchPalette from "./SearchPalette.astro";

const services = [
  { label: "AI Automation", href: "/ai-automation", icon: "workflow", desc: "Workflows & pipelines" },
  { label: "AI Agents", href: "/ai-agents", icon: "bot", desc: "Autonomous agents" },
  { label: "AI Coding", href: "/ai-coding", icon: "code", desc: "Code & dev tools" },
  { label: "AI Design", href: "/ai-design", icon: "palette", desc: "Graphics, UI & 3D" },
];
const navLink = "rounded-lg px-3.5 py-2 text-sm font-medium t-soft hover:t-strong transition-colors";
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <div class="container-page">
    <nav id="site-nav" class="glass mt-3 flex items-center justify-between rounded-2xl border b-base px-4 py-3 transition-shadow duration-300">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 font-display font-bold text-lg t-strong shrink-0">
        <span class="grid place-items-center h-9 w-9 rounded-xl text-white" style="background-image:linear-gradient(135deg,var(--primary),var(--accent))">
          <Icon name="sparkles" size={18} strokeWidth={2.2} />
        </span>
        <span class="hidden sm:inline">Nexus</span>
      </a>

      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-1">
        <li class="relative" id="services-dd">
          <button id="services-btn" type="button" aria-haspopup="true" aria-expanded="false"
            class={`${navLink} inline-flex items-center gap-1`}>
            Services
            <Icon name="chevron-down" size={15} id="services-chev" class="transition-transform duration-200" />
          </button>
          <div id="services-panel" class="absolute left-0 top-full mt-2 w-72 card p-2 hidden shadow-xl">
            {services.map((s) => (
              <a href={s.href} class="dd-link flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-surface-2 transition-colors">
                <span class="icon-tile h-8 w-8"><Icon name={s.icon} size={16} /></span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium t-strong">{s.label}</span>
                  <span class="block text-xs t-muted">{s.desc}</span>
                </span>
              </a>
            ))}
            <div class="my-1 border-t b-base"></div>
            <a href="/services" class="dd-link flex items-center justify-between rounded-lg px-3 py-2.5 hover:bg-surface-2 transition-colors text-sm font-medium t-soft">
              Browse all services <Icon name="arrow-right" size={15} class="t-muted" />
            </a>
          </div>
        </li>
        <li><a href="/services" class={navLink}>Tools</a></li>
        <li><a href="/about" class={navLink}>About</a></li>
        <li><a href="/contact" class={navLink}>Contact</a></li>
      </ul>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <button type="button" class="search-trigger flex items-center gap-2 rounded-xl border b-strong bg-surface h-10 px-3 t-muted hover:border-[color:var(--primary)] hover:t-strong transition-colors" aria-label="Search">
          <Icon name="search" size={18} />
          <span class="hidden lg:inline text-sm">Search</span>
          <kbd class="hidden lg:inline-flex items-center rounded-md border b-base bg-surface-2 px-1.5 py-0.5 text-xs t-muted">⌘K</kbd>
        </button>

        <button id="theme-toggle" type="button" aria-label="Toggle color theme"
          class="grid place-items-center h-10 w-10 rounded-xl border b-strong bg-surface t-strong hover:border-[color:var(--primary)] transition-colors">
          <Icon name="sun" size={19} class="hidden dark:block" />
          <Icon name="moon" size={19} class="block dark:hidden" />
        </button>

        <a href="/#cta" class="btn btn-gradient hidden sm:inline-flex">
          Submit a tool
          <Icon name="arrow-right" size={17} />
        </a>

        <button id="menu-toggle" type="button" aria-label="Open menu"
          class="md:hidden grid place-items-center h-10 w-10 rounded-xl border b-strong bg-surface t-strong">
          <Icon name="menu" size={20} class="block [.menu-open_&]:hidden" />
          <Icon name="x" size={20} class="hidden [.menu-open_&]:block" />
        </button>
      </div>
    </nav>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden glass mt-2 hidden rounded-2xl border b-base p-3">
      <button type="button" class="search-trigger flex w-full items-center gap-2 rounded-xl border b-strong bg-surface px-4 py-3 text-sm t-muted">
        <Icon name="search" size={18} /> Search Nexus...
        <kbd class="ml-auto rounded-md border b-base bg-surface-2 px-1.5 py-0.5 text-xs">⌘K</kbd>
      </button>
      <ul class="mt-2 flex flex-col">
        <li class="px-2 pt-2 pb-1 text-xs font-semibold uppercase tracking-wide t-muted">Services</li>
        {services.map((s) => (
          <li><a href={s.href} class="flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium t-soft hover:t-strong hover:bg-surface-2 transition-colors">
            <Icon name={s.icon} size={16} class="t-muted" /> {s.label}
          </a></li>
        ))}
        <li><a href="/services" class="flex items-center justify-between rounded-lg px-4 py-2.5 text-sm font-medium t-soft hover:t-strong hover:bg-surface-2 transition-colors">Tools <Icon name="arrow-right" size={15} class="t-muted" /></a></li>
        <li><a href="/about" class="block rounded-lg px-4 py-2.5 text-sm font-medium t-soft hover:t-strong hover:bg-surface-2 transition-colors">About</a></li>
        <li><a href="/contact" class="block rounded-lg px-4 py-2.5 text-sm font-medium t-soft hover:t-strong hover:bg-surface-2 transition-colors">Contact</a></li>
        <li class="p-2">
          <a href="/#cta" class="btn btn-gradient w-full">Submit a tool <Icon name="arrow-right" size={17} /></a>
        </li>
      </ul>
    </div>
  </div>
</header>

<SearchPalette />

<style is:global>
  #site-nav.nav-scrolled { box-shadow: 0 14px 34px -18px hsl(var(--shadow) / .55); }
</style>

<script>
  // Theme toggle
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch (e) {}
  });

  // Services dropdown
  const ddBtn = document.getElementById("services-btn");
  const ddPanel = document.getElementById("services-panel");
  const ddChev = document.getElementById("services-chev");
  const setDd = (open) => {
    ddPanel?.classList.toggle("hidden", !open);
    ddBtn?.setAttribute("aria-expanded", String(open));
    ddChev?.classList.toggle("rotate-180", open);
  };
  ddBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setDd(ddPanel?.classList.contains("hidden"));
  });
  document.addEventListener("click", (e) => {
    if (ddPanel && !ddPanel.contains(e.target) && !ddBtn?.contains(e.target)) setDd(false);
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setDd(false); });
  ddPanel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setDd(false)));

  // Mobile menu
  const menuBtn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const closeMenu = () => { menu?.classList.add("hidden"); menuBtn?.classList.remove("menu-open"); };
  menuBtn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuBtn.classList.toggle("menu-open", open);
  });
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  document.querySelectorAll("#mobile-menu .search-trigger").forEach((b) => b.addEventListener("click", closeMenu));

  // Sticky scroll shadow
  const nav = document.getElementById("site-nav");
  const onScroll = () => nav?.classList.toggle("nav-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
