---
import Icon from "./Icon.astro";

const items = [
  { title: "Home", href: "/", cat: "Pages", icon: "box", kw: "home landing nexus" },
  { title: "AI Services Directory", href: "/services", cat: "Pages", icon: "layout-dashboard", kw: "tools directory browse services models apis agents datasets search" },
  { title: "AI Tools Directory", href: "/tools", cat: "Pages", icon: "box", kw: "ai tools directory chatgpt claude cursor perplexity" },
  { title: "AI Automation", href: "/ai-automation", cat: "Services", icon: "workflow", kw: "automation workflow pipelines" },
  { title: "AI Agents", href: "/ai-agents", cat: "Services", icon: "bot", kw: "agents autonomous bots" },
  { title: "AI Coding", href: "/ai-coding", cat: "Services", icon: "code", kw: "coding code developer programming" },
  { title: "AI Design", href: "/ai-design", cat: "Services", icon: "palette", kw: "design graphics logo ui 3d" },
  { title: "About", href: "/about", cat: "Pages", icon: "info", kw: "about mission vision values" },
  { title: "Contact", href: "/contact", cat: "Pages", icon: "mail", kw: "contact email support form" },
  { title: "Privacy Policy", href: "/privacy", cat: "Legal", icon: "shield-check", kw: "privacy policy data cookies" },
  { title: "Affiliate Disclosure", href: "/affiliate-disclosure", cat: "Legal", icon: "banknote", kw: "affiliate disclosure commission" },
  { title: "Terms of Service", href: "/terms", cat: "Legal", icon: "lock", kw: "terms of service conditions tos rules" },
];
---

<div id="search-overlay" class="fixed inset-0 z-[60] hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search">
  <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative mx-auto mt-[12vh] w-[92%] max-w-xl">
    <div class="card overflow-hidden shadow-2xl">
      <div class="flex items-center gap-3 border-b b-base px-4 py-3.5">
        <Icon name="search" size={20} class="t-muted shrink-0" />
        <input id="search-input" type="search" placeholder="Search pages, services..." autocomplete="off" class="w-full bg-transparent text-base t-strong placeholder:t-muted outline-none" />
        <kbd class="hidden sm:inline-flex items-center rounded-md border b-base bg-surface-2 px-2 py-1 text-xs t-muted">ESC</kbd>
      </div>

      <div id="search-results" class="max-h-[52vh] overflow-y-auto p-2">
        {items.map((it) => (
          <a href={it.href} data-search-item data-title={it.title.toLowerCase()} data-keywords={it.kw} class="search-row group flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-surface-2 transition-colors">
            <span class="icon-tile h-9 w-9 shrink-0"><Icon name={it.icon} size={17} /></span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium t-strong truncate">{it.title}</span>
            </span>
            <span class="hidden sm:block text-xs t-muted rounded-full border b-base px-2 py-0.5">{it.cat}</span>
            <Icon name="arrow-right" size={15} class="row-arrow t-muted opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
        ))}
        <p id="search-empty" class="hidden px-4 py-10 text-center text-sm t-muted">No results found. Try another search.</p>
      </div>

      <div class="flex items-center justify-between border-t b-base px-4 py-2.5 text-xs t-muted">
        <span class="inline-flex items-center gap-1.5"><Icon name="info" size={13} /> Quick navigation</span>
        <span class="hidden sm:inline">↑↓ navigate · ↵ open</span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #search-overlay .search-row.row-active { background: var(--surface-2); }
  #search-overlay .search-row.row-active .row-arrow { opacity: 1; color: var(--primary); }
</style>

<script>
  const overlay = document.getElementById("search-overlay");
  const input = document.getElementById("search-input");
  const backdrop = document.getElementById("search-backdrop");
  const rows = Array.from(document.querySelectorAll("[data-search-item]"));
  const empty = document.getElementById("search-empty");
  let active = 0;

  const visibleRows = () => rows.filter((r) => !r.classList.contains("hidden"));

  const setActive = (idx) => {
    const vis = visibleRows();
    if (!vis.length) return;
    active = (idx + vis.length) % vis.length;
    vis.forEach((r, i) => r.classList.toggle("row-active", i === active));
    vis[active]?.scrollIntoView({ block: "nearest" });
  };

  const filter = () => {
    const q = (input?.value || "").trim().toLowerCase();
    let count = 0;
    rows.forEach((r) => {
      const hay = `${r.getAttribute("data-title")} ${r.getAttribute("data-keywords")}`;
      const match = !q || hay.includes(q);
      r.classList.toggle("hidden", !match);
      r.classList.remove("row-active");
      if (match) count++;
    });
    empty?.classList.toggle("hidden", count !== 0);
    setActive(0);
  };

  const open = () => {
    overlay?.classList.remove("hidden");
    overlay?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    if (input) input.value = "";
    filter();
    setTimeout(() => input?.focus(), 0);
  };

  const close = () => {
    overlay?.classList.add("hidden");
    overlay?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  };

  input?.addEventListener("input", filter);
  input?.addEventListener("keydown", (e) => {
    const vis = visibleRows();
    if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
    else if (e.key === "Enter") { e.preventDefault(); vis[active]?.click(); }
    else if (e.key === "Escape") { close(); }
  });

  document.querySelectorAll(".search-trigger").forEach((b) => b.addEventListener("click", open));
  backdrop?.addEventListener("click", close);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      overlay?.classList.contains("hidden") ? open() : close();
    } else if (e.key === "Escape" && overlay && !overlay.classList.contains("hidden")) {
      close();
    }
  });
</script>
