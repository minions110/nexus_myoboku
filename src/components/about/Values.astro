---
import Icon from "../Icon.astro";

const values = [
  { icon: "shield-check", title: "Independence", desc: "No paid placement. The picks we publish are genuinely ours." },
  { icon: "eye", title: "Transparency", desc: "Open about how we earn and how we choose what to recommend." },
  { icon: "star", title: "Quality over quantity", desc: "A shortlist of the best - not a list of absolutely everything." },
  { icon: "users", title: "Builder-first", desc: "Designed for the people who actually ship, not just browse." },
  { icon: "lock", title: "Privacy & trust", desc: "We respect your data and your time, and never sell you out." },
  { icon: "graduation-cap", title: "Always learning", desc: "AI moves fast - so do we, updating our research constantly." },
];
---

<section id="values" class="py-24 sm:py-32 bg-soft border-y b-base">
  <div class="container-page">
    <div class="max-w-2xl mx-auto text-center" data-reveal>
      <span class="chip mb-4 mx-auto"><Icon name="sparkles" size={14} /> Our values</span>
      <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
        What we stand for
      </h2>
      <p class="mt-4 text-lg t-soft">Six principles that guide every recommendation we make.</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {values.map((v, i) => (
        <div class="card card-hover p-7" data-reveal style={`transition-delay:${i * 55}ms`}>
          <span class="icon-tile h-12 w-12"><Icon name={v.icon} size={24} /></span>
          <h3 class="mt-5 text-lg font-semibold t-strong">{v.title}</h3>
          <p class="mt-2 text-sm t-soft leading-relaxed">{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
