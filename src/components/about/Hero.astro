---
import Icon from "../Icon.astro";
---

<section class="relative overflow-hidden pt-36 pb-16 sm:pt-44 sm:pb-20">
  <div class="absolute inset-0 -z-10 grid-bg"></div>
  <div class="orb -z-10" style="top:-8%;left:16%;width:400px;height:400px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
  <div class="orb -z-10" style="top:6%;right:10%;width:320px;height:320px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>

  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <span class="chip mx-auto mb-5"><Icon name="info" size={14} /> About Nexus</span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
        We help builders find AI that <span class="gradient-text">actually works</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg t-soft leading-relaxed">
        Nexus is an independent AI resource hub. We research, test and curate the best AI services, tools and experts - so you can cut the noise, choose with confidence, and ship faster.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm t-muted">
        <span class="inline-flex items-center gap-1.5"><Icon name="shield-check" size={15} class="text-[color:var(--primary)]" /> Independent & reader-supported</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="users" size={15} class="text-[color:var(--primary)]" /> 40,000+ builders guided</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="globe" size={15} class="text-[color:var(--primary)]" /> Made for a global audience</span>
      </div>
    </div>
  </div>
</section>
