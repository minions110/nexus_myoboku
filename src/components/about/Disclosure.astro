---
import Icon from "../Icon.astro";

const points = [
  { icon: "banknote", t: "No extra cost to you", d: "You never pay more for using an affiliate link." },
  { icon: "shield-check", t: "Never affects ratings", d: "Commissions don't influence our reviews or rankings." },
  { icon: "refresh-cw", t: "Funds independent research", d: "It keeps our testing and curation free for everyone." },
];
---

<section id="disclosure" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="max-w-3xl mx-auto" data-reveal>
      <div class="card relative overflow-hidden p-8 sm:p-10 border-l-4" style="border-left-color:var(--primary)">
        <div class="orb" style="top:-30%;right:-5%;width:220px;height:220px;background:radial-gradient(circle,var(--accent),transparent 70%);opacity:.15"></div>
        <div class="relative">
          <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-[color:var(--primary)]">
            <Icon name="info" size={13} /> Affiliate disclosure
          </span>
          <h2 class="mt-4 font-display text-2xl sm:text-3xl font-bold tracking-tight t-strong">
            How Nexus makes money
          </h2>
          <div class="mt-4 space-y-4 text-base t-soft leading-relaxed">
            <p>
              Nexus is reader-supported. Some links on this site are affiliate links, including links to marketplaces such as Fiverr. If you click an affiliate link and make a purchase, we may earn a commission at <span class="t-strong font-semibold">no additional cost to you</span>.
            </p>
            <p>
              Affiliate relationships <span class="t-strong font-semibold">never influence</span> our recommendations, ratings or reviews. We only promote services we believe add real value - and we say so honestly. Your trust is worth more than any commission.
            </p>
          </div>

          <div class="mt-7 grid sm:grid-cols-3 gap-4 border-t b-base pt-6">
            {points.map((p) => (
              <div>
                <span class="icon-tile h-10 w-10"><Icon name={p.icon} size={20} /></span>
                <p class="mt-3 text-sm font-semibold t-strong">{p.t}</p>
                <p class="mt-1 text-xs t-muted leading-relaxed">{p.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
