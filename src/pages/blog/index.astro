---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import { getAllPosts } from "../../data";

const posts = getAllPosts();

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Layout
  title="Blog - AI Tool Guides & Reviews | Myoboku AI"
  description="Guides, comparisons and hands-on reviews of the best AI tools. Learn how to choose and ship with AI chat, coding, image, video and automation tools."
>
  <Navbar />
  <main>
    <section class="relative overflow-hidden pt-36 pb-12 sm:pt-44">
      <div class="absolute inset-0 -z-10 grid-bg"></div>
      <div class="orb -z-10" style="top:-8%;left:16%;width:400px;height:400px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
      <div class="orb -z-10" style="top:6%;right:10%;width:320px;height:320px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>

      <div class="container-page">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <span class="chip mx-auto mb-5"><Icon name="pen-tool" size={14} /> Blog</span>
          <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
            AI tool <span class="gradient-text">guides & reviews</span>
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg t-soft">
            Comparisons, deep-dives and practical advice to help you choose and ship with the right AI tools.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 sm:pb-32">
      <div class="container-page">
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <a href={`/blog/${p.slug}`} class="card card-hover group flex flex-col overflow-hidden">
              <div
                class="relative h-36"
                style={`background-image:linear-gradient(135deg,hsl(${p.hue} 70% 55%),hsl(${(p.hue + 45) % 360} 70% 45%))`}
              >
                <div class="absolute inset-0 grid-bg opacity-40"></div>
                <span class="absolute left-4 top-4 chip !bg-black/25 !border-white/20 !text-white">{p.category}</span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h2 class="font-display text-lg font-bold t-strong transition-colors group-hover:text-[color:var(--primary)]">
                  {p.title}
                </h2>
                <p class="mt-2 line-clamp-3 text-sm t-soft leading-relaxed flex-1">{p.excerpt}</p>
                <div class="mt-4 flex items-center gap-2 text-xs t-muted">
                  <Icon name="clock" size={13} />
                  {fmt(p.date)} · {p.readingTime} min read
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
