---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import { getProductBySlug, getRecentPosts } from "../../data";

const product = getProductBySlug("ai-custom-bracelet-design");

if (!product) {
  throw new Error("Product not found: ai-custom-bracelet-design");
}

const trackProps = JSON.stringify({ product_id: product.id, product_name: product.name });

const siteUrl = Astro.site?.href ?? "";

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  category: product.category,
  brand: { "@type": "Brand", name: "Myoboku AI" },
  offers: product.pricing.map((tier) => ({
    "@type": "Offer",
    name: tier.name,
    price: tier.price,
    priceCurrency: tier.currency,
    availability: "https://schema.org/InStock",
    url: `${siteUrl}products/${product.slug}`,
  })),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const relatedPosts = getRecentPosts(20).filter((p) =>
  ["ai-bracelet-design-from-story", "how-to-design-personalized-crystal-bracelet", "ai-bracelet-design-workflow", "bracelet-design-demo-concept"].includes(p.slug)
).slice(0, 3);
---

<Layout
  title={product.seoTitle}
  description={product.seoDescription}
  image={product.coverImage}
>
  <Navbar />
  <main>
    <!-- Product Hero -->
    <section class="relative overflow-hidden pt-36 pb-16 sm:pt-44">
      <div class="absolute inset-0 -z-10 grid-bg"></div>
      <div class="orb -z-10" style="top:-8%;left:15%;width:400px;height:400px;background:radial-gradient(circle,#8b5cf6,transparent 70%)"></div>
      <div class="orb -z-10" style="top:5%;right:10%;width:350px;height:350px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>

      <div class="container-page">
        <div class="grid lg:grid-cols-2 gap-12 items-center" data-reveal>
          <div>
            <span class="chip mb-5">
              <Icon name="sparkles" size={14} /> {product.category}
            </span>
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight">
              {product.name.split(" ").slice(0, 3).join(" ")}
              <span class="gradient-text">{product.name.split(" ").slice(3).join(" ")}</span>
            </h1>
            <p class="mt-6 text-lg t-soft leading-relaxed max-w-xl">
              {product.tagline}
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a href={product.requestPath} class="btn btn-gradient w-full sm:w-auto" data-track="start_design" data-track-props={trackProps}>
                Start Your Design
                <Icon name="arrow-right" size={18} />
              </a>
              <a href="#how-it-works" class="btn btn-ghost w-full sm:w-auto">
                <Icon name="layers" size={18} />
                How It Works
              </a>
            </div>
          </div>
          <div class="relative">
            <div class="rounded-[1.5rem] border b-strong p-8 shadow-2xl grid place-items-center"
              style="background:linear-gradient(135deg,var(--surface),var(--surface-2))">
              <img src={product.coverImage} alt={product.name} width="160" height="160" class="rounded-3xl shadow-xl" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Customer Journey -->
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <div class="max-w-2xl mb-12" data-reveal>
          <span class="chip mb-4"><Icon name="map" size={14} /> Your Journey</span>
          <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
            From story to <span class="gradient-text">finished design</span>
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {product.customerJourney.map((step, i) => (
            <div data-reveal style={`transition-delay:${i * 60}ms`} class="card card-hover p-6 relative">
              <span class="absolute -top-3 -left-3 grid h-8 w-8 place-items-center rounded-full text-sm font-bold text-white"
                style="background-image:linear-gradient(135deg,var(--primary),var(--secondary))">
                {step.step}
              </span>
              <h3 class="mt-3 font-semibold t-strong">{step.title}</h3>
              <p class="mt-2 text-sm t-soft leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-20 sm:py-28">
      <div class="container-page">
        <div class="max-w-2xl mb-12" data-reveal>
          <span class="chip mb-4"><Icon name="workflow" size={14} /> Process</span>
          <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
            How it <span class="gradient-text">works</span>
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {product.howItWorks.map((step, i) => (
            <div data-reveal style={`transition-delay:${i * 60}ms`} class="card card-hover p-6 relative">
              <span class="absolute -top-3 -left-3 grid h-8 w-8 place-items-center rounded-full text-sm font-bold text-white"
                style="background-image:linear-gradient(135deg,var(--primary),var(--secondary))">
                {step.step}
              </span>
              <h3 class="mt-3 font-semibold t-strong">{step.title}</h3>
              <p class="mt-2 text-sm t-soft leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What You Share / What You Receive -->
    <section class="py-20 sm:py-28 bg-surface-2/50">
      <div class="container-page">
        <div class="grid md:grid-cols-2 gap-12" data-reveal>
          <div>
            <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight mb-6">
              What you <span class="gradient-text">share</span>
            </h3>
            <ul class="space-y-3">
              {product.whatYouShare.map((item) => (
                <li class="flex items-center gap-3 text-sm t-soft">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-violet-500/10 text-violet-500">
                    <Icon name="upload" size={13} />
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight mb-6">
              What you <span class="gradient-text">receive</span>
            </h3>
            <ul class="space-y-3">
              {product.whatYouReceive.map((item) => (
                <li class="flex items-center gap-3 text-sm t-soft">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-emerald-500/10 text-emerald-500">
                    <Icon name="check" size={13} />
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-20 sm:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center mb-12" data-reveal>
          <span class="chip mb-4"><Icon name="tag" size={14} /> Pricing</span>
          <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
            Choose your <span class="gradient-text">design package</span>
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3 max-w-4xl mx-auto">
          {product.pricing.map((tier, i) => (
            <div
              data-reveal
              style={`transition-delay:${i * 60}ms`}
              class={`card p-6 flex flex-col ${tier.highlighted ? "ring-2 ring-[color:var(--primary)] shadow-xl relative" : ""}`}
            >
              {tier.highlighted && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 chip text-xs font-semibold text-white"
                  style="background-image:linear-gradient(135deg,var(--primary),var(--secondary));border:none">
                  Most Popular
                </span>
              )}
              <h3 class="font-semibold t-strong text-lg">{tier.name}</h3>
              <p class="mt-1 text-sm t-muted">{tier.description}</p>
              <p class="mt-4">
                <span class="font-display text-4xl font-bold t-strong">${tier.price}</span>
              </p>
              <ul class="mt-5 space-y-2.5 flex-1">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm t-soft">
                    <Icon name="check" size={15} class="text-[color:var(--primary)] shrink-0 mt-0.5" />
                    {f}
                  </li>
                ))}
              </ul>
              <a href={tier.href} class={`mt-6 btn w-full ${tier.highlighted ? "btn-gradient" : "btn-ghost"}`}
                data-track="checkout_click"
                data-track-props={JSON.stringify({ product_id: product.id, plan_id: tier.name.toLowerCase() })}
              >
                {tier.cta}
              </a>
            </div>
          ))}
        </div>
        <div class="mx-auto max-w-4xl mt-8 text-center">
          <p class="text-sm t-muted mb-3">Digital delivery • 3–5 business days • No physical shipping</p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            <a href="/refund-policy" class="t-muted hover:text-[color:var(--primary)] transition-colors underline underline-offset-2">Refund Policy</a>
            <a href="/delivery-policy" class="t-muted hover:text-[color:var(--primary)] transition-colors underline underline-offset-2">Delivery Policy</a>
            <a href="/revision-policy" class="t-muted hover:text-[color:var(--primary)] transition-colors underline underline-offset-2">Revision Policy</a>
            <a href="/digital-product-terms" class="t-muted hover:text-[color:var(--primary)] transition-colors underline underline-offset-2">Digital Product Terms</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 sm:py-28 bg-surface-2/50">
      <div class="container-page">
        <div class="max-w-2xl mb-12" data-reveal>
          <span class="chip mb-4"><Icon name="info" size={14} /> FAQ</span>
          <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
            Common <span class="gradient-text">questions</span>
          </h2>
        </div>
        <div class="max-w-3xl space-y-4">
          {product.faqs.map((faq, i) => (
            <details data-reveal style={`transition-delay:${i * 40}ms`} class="card group cursor-pointer">
              <summary class="flex items-center justify-between p-5 font-semibold t-strong list-none">
                {faq.q}
                <Icon name="chevron-down" size={18} class="t-muted transition-transform group-open:rotate-180" />
              </summary>
              <p class="px-5 pb-5 text-sm t-soft leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Articles -->
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <div class="max-w-2xl mb-12" data-reveal>
          <span class="chip mb-4"><Icon name="book-open" size={14} /> Learn More</span>
          <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
            Related <span class="gradient-text">articles</span>
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {relatedPosts.map((post, i) => (
            <a href={`/blog/${post.slug}`} data-reveal style={`transition-delay:${i * 60}ms`} class="card card-hover group flex flex-col p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-[color:var(--primary)]">{post.category}</span>
              <h3 class="mt-2 text-base font-semibold t-strong leading-snug group-hover:text-[color:var(--primary)] transition-colors">{post.title}</h3>
              <p class="mt-2 text-sm t-soft leading-relaxed flex-1">{post.excerpt}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--primary)]">
                Read article
                <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <h2 class="font-display text-3xl sm:text-5xl font-bold tracking-tight">
            Ready to <span class="gradient-text">design your bracelet?</span>
          </h2>
          <p class="mt-4 text-lg t-soft">
            Share your story and we'll turn it into a personalized bracelet design proposal.
          </p>
          <a href={product.requestPath} class="btn btn-gradient mt-8" data-track="start_design" data-track-props={trackProps}>
            Start Your Design
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import { initAnalytics, track } from "../../lib/analytics";
    initAnalytics();
    track("product_view", { product_id: "ai-custom-bracelet-design", product_name: "AI Custom Bracelet Design" });
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
