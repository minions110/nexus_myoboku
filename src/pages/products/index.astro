---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import { getAllProducts } from "../../data";

const products = getAllProducts();
const available = products.filter((p) => p.status === "available");
const comingSoon = products.filter((p) => p.status === "coming-soon");

const siteUrl = Astro.site?.href ?? "";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "AI Products", item: `${siteUrl}products/` },
  ],
};
---

<Layout
  title="AI Products - Myoboku AI"
  description="Explore Myoboku AI's own digital products — AI-assisted design services and tools built for real workflows."
>
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden pt-36 pb-12 sm:pt-44">
      <div class="absolute inset-0 -z-10 grid-bg"></div>
      <div class="orb -z-10" style="top:-10%;left:18%;width:380px;height:380px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
      <div class="orb -z-10" style="top:0%;right:10%;width:320px;height:320px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>

      <div class="container-page">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <span class="chip mx-auto mb-5">
            <Icon name="sparkles" size={14} /> AI Products
          </span>
          <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
            Products that turn <span class="gradient-text">ideas into workflows</span>
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg t-soft">
            Myoboku AI's own digital products and design services. Built in-house, delivered with care, designed for real people.
          </p>
        </div>
      </div>
    </section>

    <!-- Available Products -->
    <section class="py-16">
      <div class="container-page">
        <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight mb-8" data-reveal>
          Available <span class="gradient-text">now</span>
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {available.map((p, i) => (
            <a
              href={`/products/${p.slug}`}
              data-reveal
              style={`transition-delay:${i * 60}ms`}
              class="card card-hover group flex flex-col overflow-hidden"
            >
              <div class="relative h-48 bg-gradient-to-br from-indigo-500/10 via-violet-500/10 to-fuchsia-500/10 grid place-items-center">
                <img src={p.coverImage} alt={p.name} width="96" height="96" class="rounded-2xl shadow-lg" />
                <span class="absolute top-3 left-3 chip text-xs"><Icon name="check" size={12} /> Live</span>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <span class="text-xs font-semibold uppercase tracking-wider text-[color:var(--primary)]">{p.category}</span>
                <h3 class="mt-2 text-lg font-semibold t-strong group-hover:text-[color:var(--primary)] transition-colors">{p.name}</h3>
                <p class="mt-2 text-sm t-soft leading-relaxed flex-1">{p.tagline}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--primary)]">
                  Learn more
                  <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Coming Soon -->
    {comingSoon.length > 0 && (
      <section class="py-16">
        <div class="container-page">
          <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight mb-8" data-reveal>
            Coming <span class="gradient-text">soon</span>
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {comingSoon.map((p, i) => (
              <div
                data-reveal
                style={`transition-delay:${i * 60}ms`}
                class="card flex flex-col overflow-hidden opacity-60"
              >
                <div class="relative h-48 bg-gradient-to-br from-gray-500/5 to-gray-600/10 grid place-items-center">
                  <img src={p.coverImage} alt={p.name} width="96" height="96" class="rounded-2xl shadow-lg grayscale" />
                  <span class="absolute top-3 left-3 chip text-xs"><Icon name="clock" size={12} /> Coming Soon</span>
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <span class="text-xs font-semibold uppercase tracking-wider t-muted">{p.category}</span>
                  <h3 class="mt-2 text-lg font-semibold t-strong">{p.name}</h3>
                  <p class="mt-2 text-sm t-soft leading-relaxed flex-1">{p.tagline}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>
