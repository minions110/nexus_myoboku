---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";

const updated = "July 29, 2026";

const toc = [
  { id: "introduction", label: "Introduction" },
  { id: "information", label: "Information we collect" },
  { id: "use", label: "How we use it" },
  { id: "cookies", label: "Cookies & tracking" },
  { id: "affiliate", label: "Affiliate links" },
  { id: "sharing", label: "Sharing & disclosure" },
  { id: "retention", label: "Data retention" },
  { id: "rights", label: "Your rights" },
  { id: "children", label: "Children's privacy" },
  { id: "security", label: "Security" },
  { id: "changes", label: "Changes to this policy" },
  { id: "contact", label: "Contact us" },
];

const h2 = "font-display text-2xl sm:text-3xl font-bold tracking-tight t-strong scroll-mt-28";
const para = "mt-4 text-base t-soft leading-relaxed";
const h3 = "mt-6 text-base font-semibold t-strong";
const ul = "mt-4 space-y-2.5";
const li = "flex items-start gap-2.5 text-sm t-soft leading-relaxed";
const dot = "mt-[0.45rem] h-1.5 w-1.5 rounded-full shrink-0";
---

<Layout
  title="Privacy Policy | Myoboku AI"
  description="How Myoboku AI collects, uses, and protects your information. A plain-language privacy policy covering data collection, cookies, affiliate links, your rights, and more."
>
  <Navbar />
  <main>
    <!-- Hero -->
    <section id="top" class="relative overflow-hidden pt-36 pb-12 sm:pt-44 sm:pb-16">
      <div class="absolute inset-0 -z-10 grid-bg"></div>
      <div class="orb -z-10" style="top:-8%;left:16%;width:380px;height:380px;background:radial-gradient(circle,#4f46e5,transparent 70%)"></div>
      <div class="orb -z-10" style="top:6%;right:12%;width:300px;height:300px;background:radial-gradient(circle,#06b6d4,transparent 70%)"></div>
      <div class="container-page">
        <div class="max-w-3xl" data-reveal>
          <span class="chip mb-5"><Icon name="shield-check" size={14} /> Legal</span>
          <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">Privacy Policy</h1>
          <p class="mt-5 max-w-2xl text-lg t-soft leading-relaxed">
            How Myoboku AI collects, uses, and protects your information. Plain language, no fine print - just what you need to know.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm t-muted">
            <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={15} class="text-[color:var(--primary)]" /> Last updated: {updated}</span>
            <span class="inline-flex items-center gap-1.5"><Icon name="lock" size={15} class="text-[color:var(--primary)]" /> We never sell your data</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Body: TOC + content -->
    <section class="pb-24 sm:pb-32">
      <div class="container-page">
        <div class="grid lg:grid-cols-[240px_1fr] gap-10 lg:gap-16">
          <!-- Table of contents -->
          <aside class="hidden lg:block">
            <div class="sticky top-28">
              <p class="text-xs font-semibold uppercase tracking-wide t-muted mb-4">On this page</p>
              <nav class="border-l b-base">
                {toc.map((t, i) => (
                  <a
                    data-toc-link={t.id}
                    href={`#${t.id}`}
                    class="toc-link -ml-px block border-l-2 border-transparent pl-4 py-1.5 text-sm t-muted hover:t-strong hover:border-[color:var(--primary)] transition-colors"
                  >
                    <span class="t-muted mr-2 tabular-nums">{String(i + 1).padStart(2, "0")}</span>{t.label}
                  </a>
                ))}
              </nav>
            </div>
          </aside>

          <!-- Content -->
          <div class="min-w-0 max-w-3xl">
            <!-- Summary -->
            <div class="card p-6 sm:p-7 border-l-4" style="border-left-color:var(--primary)" data-reveal>
              <p class="flex items-center gap-2 text-sm font-semibold t-strong">
                <Icon name="sparkles" size={16} class="text-[color:var(--primary)]" /> In short
              </p>
              <p class="mt-2 text-sm t-soft leading-relaxed">
                We collect minimal data to run and improve Myoboku AI, never sell your information, and only share it when necessary or legally required. You're in control - and you can reach us anytime at myobokuai@gmail.com.
              </p>
            </div>

            <!-- 1. Introduction -->
            <div data-toc-section="introduction" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Introduction</h2>
              <p class={para}>
                Myoboku AI ("we", "us", "our") provides curated AI resources, tools, and services through our website. This Privacy Policy explains what information we collect, how we use it, and the choices you have. By using our site, you agree to the practices described here.
              </p>
            </div>

            <!-- 2. Information we collect -->
            <div data-toc-section="information" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Information we collect</h2>
              <h3 class={h3}>Information you provide</h3>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> When you contact us or submit a business inquiry - such as your name, email, company, and message.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> When you voluntarily subscribe to updates or submit a tool for review.</li>
              </ul>
              <h3 class={h3}>Information collected automatically</h3>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Technical data like IP address, browser type, device, and pages visited.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Usage data gathered via cookies and analytics tools (see below).</li>
              </ul>
              <p class={para}>We do not directly collect sensitive payment details - any transactions happen on trusted third-party platforms.</p>
            </div>

            <!-- 3. How we use it -->
            <div data-toc-section="use" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>How we use your information</h2>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Respond to your inquiries, messages, and support requests.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Operate, maintain, and improve the site and our content.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Understand how visitors use our resources through analytics.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Send updates only when you have explicitly opted in.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Detect, prevent, and address technical issues or abuse.</li>
              </ul>
            </div>

            <!-- 4. Cookies -->
            <div data-toc-section="cookies" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Cookies & tracking technologies</h2>
              <p class={para}>We use cookies and similar technologies for basic functionality and analytics. The main types we use are:</p>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> <span class="font-semibold t-strong">Essential</span> - required for the site to function properly.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> <span class="font-semibold t-strong">Analytics</span> - help us understand anonymous traffic and usage.</li>
              </ul>
              <p class={para}>You can control or disable cookies through your browser settings. Note that disabling some cookies may affect how the site works.</p>
            </div>

            <!-- 5. Affiliate links -->
            <div data-toc-section="affiliate" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Affiliate links & third-party services</h2>
              <p class={para}>
                Myoboku AI is reader-supported. Some links on our site are affiliate links to third-party marketplaces and services (for example, Fiverr). If you click an affiliate link and make a purchase, we may earn a commission at no additional cost to you.
              </p>
              <p class={para}>
                These third parties have their own privacy policies that govern any data you share with them. We encourage you to review their policies. We are not responsible for the data practices of external sites.
              </p>
            </div>

            <!-- 6. Sharing -->
            <div data-toc-section="sharing" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Data sharing & disclosure</h2>
              <p class={para}>We do not sell your personal data. We may share information only in these limited situations:</p>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> With trusted service providers who help us operate the site (e.g., hosting, analytics), under appropriate confidentiality obligations.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> When required by law, regulation, or valid legal process.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> In connection with a merger, acquisition, or sale of assets.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> In aggregated or anonymized form that can no longer identify you.</li>
              </ul>
            </div>

            <!-- 7. Retention -->
            <div data-toc-section="retention" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Data retention</h2>
              <p class={para}>
                We keep personal data only as long as necessary for the purposes described in this policy, or as required by law. Contact-form submissions are retained for a limited period to respond and for record-keeping, after which they are deleted or anonymized.
              </p>
            </div>

            <!-- 8. Rights -->
            <div data-toc-section="rights" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Your rights</h2>
              <p class={para}>Depending on where you live (for example, under the GDPR or CCPA), you may have the right to:</p>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Access the personal data we hold about you.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Request correction or deletion of your data.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Opt out of marketing communications at any time.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Object to or restrict certain processing of your data.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Withdraw consent where processing relies on it.</li>
              </ul>
              <p class={para}>To exercise any of these rights, email <a href="mailto:myobokuai@gmail.com" class="font-semibold text-[color:var(--primary)] hover:underline">myobokuai@gmail.com</a>.</p>
            </div>

            <!-- 9. Children -->
            <div data-toc-section="children" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Children's privacy</h2>
              <p class={para}>
                Our site is not directed to children under 13 (or the applicable age in your jurisdiction), and we do not knowingly collect their personal information. If you believe a child has provided us with data, please contact us and we will promptly delete it.
              </p>
            </div>

            <!-- 10. Security -->
            <div data-toc-section="security" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Security</h2>
              <p class={para}>
                We use reasonable technical and organizational measures to protect your information. However, no method of transmission or storage is completely secure. We work to safeguard your data using industry-standard practices, but we cannot guarantee absolute security.
              </p>
            </div>

            <!-- 11. Changes -->
            <div data-toc-section="changes" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Changes to this policy</h2>
              <p class={para}>
                We may update this Privacy Policy from time to time. When we do, we'll revise the "Last updated" date above and, for material changes, provide notice on the site. Your continued use of Myoboku AI after changes take effect constitutes acceptance of the updated policy.
              </p>
            </div>

            <!-- 12. Contact -->
            <div data-toc-section="contact" class="pt-10 mt-10 border-t b-base">
              <h2 class={h2}>Contact us</h2>
              <p class={para}>
                Questions about this policy or your personal data? We're here to help. Email us at <a href="mailto:myobokuai@gmail.com" class="font-semibold text-[color:var(--primary)] hover:underline">myobokuai@gmail.com</a> or reach out through our contact page.
              </p>

              <div class="card p-6 sm:p-8 mt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
                <div>
                  <h3 class="font-display text-xl font-bold t-strong">Have a privacy question?</h3>
                  <p class="mt-1 text-sm t-soft">We're happy to help with access, deletion, or any privacy concern.</p>
                </div>
                <div class="flex flex-wrap gap-3 shrink-0">
                  <a href="mailto:myobokuai@gmail.com" class="btn btn-gradient"><Icon name="mail" size={16} /> Email us</a>
                  <a href="/contact" class="btn btn-ghost"><Icon name="arrow-right" size={16} /> Contact page</a>
                </div>
              </div>
            </div>

            <a href="#top" class="mt-10 inline-flex items-center gap-1.5 text-sm t-muted hover:t-strong transition-colors">
              <Icon name="arrow-right" size={15} class="-rotate-90" /> Back to top
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .toc-link.toc-active {
    color: var(--primary);
    font-weight: 600;
    border-color: var(--primary);
  }
</style>

<script>
  const links = document.querySelectorAll(".toc-link");
  const sections = document.querySelectorAll("[data-toc-section]");
  const setActive = (id) => {
    links.forEach((l) =>
      l.classList.toggle("toc-active", l.getAttribute("data-toc-link") === id)
    );
  };
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) setActive(e.target.getAttribute("data-toc-section"));
      });
    },
    { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
  );
  sections.forEach((s) => obs.observe(s));
</script>
