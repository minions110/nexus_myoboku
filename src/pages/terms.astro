---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";

const updated = "July 2026";

const toc = [
  { id: "introduction", label: "Introduction" },
  { id: "usage", label: "Website Usage" },
  { id: "third-party", label: "Third-party Services" },
  { id: "affiliate", label: "Affiliate Disclosure" },
  { id: "disclaimer", label: "Disclaimer" },
  { id: "external", label: "External Links" },
  { id: "liability", label: "Liability" },
  { id: "changes", label: "Changes" },
  { id: "contact", label: "Contact" },
];

const h2 = "font-display text-2xl sm:text-3xl font-bold tracking-tight t-strong";
const para = "mt-4 text-base t-soft leading-relaxed";
const h3 = "mt-6 text-base font-semibold t-strong";
const ul = "mt-4 space-y-2.5";
const li = "flex items-start gap-2.5 text-sm t-soft leading-relaxed";
const dot = "mt-[0.45rem] h-1.5 w-1.5 rounded-full shrink-0";
const section = "pt-10 mt-10 border-t b-base scroll-mt-28";
---

<Layout
  title="Terms of Service | AI Resource Hub"
  description="Read the Terms of Service for our AI tools and AI services recommendation platform."
>
  <Navbar />
  <main>
    <!-- Hero (center aligned) -->
    <section id="top" class="relative overflow-hidden pt-36 pb-12 sm:pt-44 sm:pb-16 text-center">
      <div class="absolute inset-0 -z-10 grid-bg"></div>
      <div class="orb -z-10" style="top:-12%;left:50%;transform:translateX(-50%);width:560px;height:420px;background:radial-gradient(circle,#4f46e5,transparent 70%);opacity:.5"></div>

      <div class="container-page">
        <div class="mx-auto max-w-3xl" data-reveal>
          <span class="chip mb-5 mx-auto"><Icon name="shield-check" size={14} /> Legal</span>
          <h1 class="font-display text-4xl sm:text-6xl font-bold leading-[1.05] tracking-tight">Terms of Service</h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg t-soft leading-relaxed">
            Please review the terms and conditions for using our AI resource platform.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm t-muted">
            <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={15} class="text-[color:var(--primary)]" /> Last updated: {updated}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Body: sidebar + content -->
    <section class="pb-24 sm:pb-32">
      <div class="container-page">
        <div class="grid lg:grid-cols-[240px_1fr] gap-10 lg:gap-16">
          <!-- Sidebar TOC (desktop only) -->
          <aside class="hidden lg:block">
            <div class="sticky top-28">
              <p class="text-xs font-semibold uppercase tracking-wide t-muted mb-4">On this page</p>
              <nav class="border-l b-base">
                {toc.map((t, i) => (
                  <a
                    data-toc-link={t.id}
                    href={`#${t.id}`}
                    class="toc-link -ml-px block border-l-2 border-transparent pl-4 py-1.5 text-sm t-muted hover:t-strong hover:border-[color:var(--primary)] transition-colors"
                  >
                    <span class="t-muted mr-2 tabular-nums">{String(i + 1).padStart(2, "0")}</span>{t.label}
                  </a>
                ))}
              </nav>
            </div>
          </aside>

          <!-- Content (max 800px) -->
          <div class="min-w-0 max-w-[800px]">
            <!-- Summary -->
            <div class="card p-6 sm:p-7 border-l-4" style="border-left-color:var(--primary)" data-reveal>
              <p class="flex items-center gap-2 text-sm font-semibold t-strong">
                <Icon name="sparkles" size={16} class="text-[color:var(--primary)]" /> In short
              </p>
              <p class="mt-2 text-sm t-soft leading-relaxed">
                By using Myoboku AI, you agree to these terms. We provide information about AI tools and services, recommend third parties we don't control, and may earn affiliate commissions at no extra cost to you. Please use the site lawfully and review third-party terms before purchasing.
              </p>
            </div>

            <!-- 1. Introduction -->
            <div data-toc-section="introduction" class={section}>
              <h2 class={h2}>1. Introduction</h2>
              <p class={para}>
                Myoboku AI ("we", "us", "our") operates a website that provides information about AI tools, AI services, freelancers, and related resources. By accessing or using our website, you agree to be bound by these Terms of Service. If you do not agree with any part of these terms, please do not use the site.
              </p>
            </div>

            <!-- 2. Website Usage -->
            <div data-toc-section="usage" class={section}>
              <h2 class={h2}>2. Website Usage</h2>
              <p class={para}>
                You agree to use the website only for lawful purposes and in a manner that does not infringe the rights of others. You are responsible for your activity on the site and for ensuring your compliance with applicable laws.
              </p>
              <h3 class={h3}>Prohibited activities</h3>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Scraping, automated harvesting, or excessive data extraction from the site.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Attempting to disrupt, overload, or compromise site security or infrastructure.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Infringing intellectual property, privacy, or other rights of any party.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Transmitting malware, viruses, or any harmful code.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Using the site for fraudulent, deceptive, or unlawful purposes.</li>
              </ul>
              <p class={para}>We reserve the right to suspend or block access for anyone who violates these terms.</p>
            </div>

            <!-- 3. AI Tools and Third-party Services -->
            <div data-toc-section="third-party" class={section}>
              <h2 class={h2}>3. AI Tools and Third-party Services</h2>
              <p class={para}>
                Our website recommends and links to third-party AI tools, services, and freelancers. We do not own, operate, or control these third-party offerings, and we are not responsible for their availability, pricing, performance, or quality.
              </p>
              <ul class={ul}>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> We do not own or operate the third-party services we recommend.</li>
                <li class={li}><span class={dot} style="background:var(--primary)"></span> Users should review each third party's terms, privacy policy, and conditions before purchasing or using them.</li>
              </ul>
              <p class={para}>
                Any purchase, subscription, or engagement is a transaction solely between you and the third party, and is governed by their terms - not ours.
              </p>
            </div>

            <!-- 4. Affiliate Disclosure -->
            <div data-toc-section="affiliate" class={section}>
              <h2 class={h2}>4. Affiliate Disclosure</h2>
              <p class={para}>
                Some links on this site may be affiliate links. If you click an affiliate link and make a qualifying purchase, we may earn a commission. This does not increase your cost - you pay the same price you would otherwise.
              </p>
              <p class={para}>
                Affiliate relationships never influence our recommendations, ratings, or reviews. For full details, please read our <a href="/affiliate-disclosure" class="font-semibold text-[color:var(--primary)] hover:underline">Affiliate Disclosure</a>.
              </p>
            </div>

            <!-- 5. Information Disclaimer -->
            <div data-toc-section="disclaimer" class={section}>
              <h2 class={h2}>5. Information Disclaimer</h2>
              <p class={para}>
                All content on this website is provided for general informational purposes only. We do not guarantee the accuracy, completeness, timeliness, or availability of any information or third-party service listed on the site.
              </p>
              <p class={para}>
                We do not warrant any specific results from using recommended tools or services, and nothing on this site constitutes professional, legal, or financial advice. Always conduct your own research and due diligence before making decisions.
              </p>
            </div>

            <!-- 6. External Links -->
            <div data-toc-section="external" class={section}>
              <h2 class={h2}>6. External Links</h2>
              <p class={para}>
                Our site contains links to external websites and third-party platforms. These external sites have their own terms, privacy policies, and practices, which we do not control and are not responsible for.
              </p>
              <p class={para}>
                We encourage you to review the terms and policies of any external website before interacting with it or providing any personal information.
              </p>
            </div>

            <!-- 7. Limitation of Liability -->
            <div data-toc-section="liability" class={section}>
              <h2 class={h2}>7. Limitation of Liability</h2>
              <p class={para}>
                To the maximum extent permitted by law, Myoboku AI and its operators shall not be liable for any indirect, incidental, special, or consequential damages - including loss of profits, data, or goodwill - arising from your use of, or inability to use, the website or any third-party service.
              </p>
              <p class={para}>
                The website and its content are provided on an "as is" and "as available" basis, without warranties of any kind, express or implied.
              </p>
            </div>

            <!-- 8. Changes to Terms -->
            <div data-toc-section="changes" class={section}>
              <h2 class={h2}>8. Changes to Terms</h2>
              <p class={para}>
                We may update these Terms of Service from time to time. When we do, we will revise the "Last updated" date at the top of this page. Your continued use of the website after changes take effect constitutes acceptance of the updated terms.
              </p>
              <p class={para}>We encourage you to review this page periodically to stay informed of any changes.</p>
            </div>

            <!-- 9. Contact Information -->
            <div data-toc-section="contact" class={section}>
              <h2 class={h2}>9. Contact Information</h2>
              <p class={para}>
                If you have questions about these Terms, please contact us. We're happy to clarify anything in these Terms of Service.
              </p>
              <div class="card p-6 sm:p-8 mt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
                <div>
                  <h3 class="font-display text-xl font-bold t-strong">Questions about these Terms?</h3>
                  <p class="mt-1 text-sm t-soft">Reach out and we'll get back to you within 1-2 business days.</p>
                </div>
                <div class="flex flex-wrap gap-3 shrink-0">
                  <a href="mailto:myobokuai@gmail.com" class="btn btn-gradient"><Icon name="mail" size={16} /> Email us</a>
                  <a href="/contact" class="btn btn-ghost"><Icon name="arrow-right" size={16} /> Contact page</a>
                </div>
              </div>
            </div>

            <a href="#top" class="mt-10 inline-flex items-center gap-1.5 text-sm t-muted hover:t-strong transition-colors">
              <Icon name="arrow-right" size={15} class="-rotate-90" /> Back to top
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .toc-link.toc-active {
    color: var(--primary);
    font-weight: 600;
    border-color: var(--primary);
  }
</style>

<script>
  const links = document.querySelectorAll(".toc-link");
  const sections = document.querySelectorAll("[data-toc-section]");
  const setActive = (id) => {
    links.forEach((l) =>
      l.classList.toggle("toc-active", l.getAttribute("data-toc-link") === id)
    );
  };
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) setActive(e.target.getAttribute("data-toc-section"));
      });
    },
    { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
  );
  sections.forEach((s) => obs.observe(s));
</script>
